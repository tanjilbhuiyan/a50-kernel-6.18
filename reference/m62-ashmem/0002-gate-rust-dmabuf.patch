From 078d5dbf171838e43dee64ecd409309113862e8f Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Wed, 11 Nov 2026 06:01:53 +0600
Subject: [PATCH] rust: build dma-buf abstractions only with DMA_SHARED_BUFFER

Without CONFIG_DMA_SHARED_BUFFER the Rust kernel crate links references to unavailable dma-buf functions. Match the config that provides the C implementation.

Change-Id: I218a95a3713a6d4ba98f45617a9393a17145c5ba
---
 rust/kernel/lib.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rust/kernel/lib.rs b/rust/kernel/lib.rs
index d2ca461c3..1d55e8c6c 100644
--- a/rust/kernel/lib.rs
+++ b/rust/kernel/lib.rs
@@ -87,6 +87,7 @@
 pub mod device_id;
 pub mod devres;
 pub mod dma;
+#[cfg(CONFIG_DMA_SHARED_BUFFER)]
 pub mod dma_buf;
 pub mod driver;
 #[cfg(CONFIG_DRM = "y")]
