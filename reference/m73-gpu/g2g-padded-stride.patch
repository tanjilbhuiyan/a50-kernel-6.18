+static u64 a50_dma_bytes(struct a50_layer *l)
+{
+	u64 bytes;
+
+	if (l->dpp < 0 || !l->linear ||
+	    l->src.x || l->src.y || l->src.w != FB_W || l->src.h != FB_H ||
+	    l->dst.x || l->dst.y || l->dst.w != FB_W || l->dst.h != FB_H ||
+	    l->src.f_w < FB_W || l->src.f_w > A50_SRC_FULL_W_MAX ||
+	    l->src.f_h < FB_H || l->src.f_h > A50_SRC_FULL_H_MAX)
+		return 0;
+	/* Validate the whole padded extent, not just the visible tight image. */
+	bytes = (u64)l->src.f_w * l->src.f_h * 4;
+	return bytes <= l->buf->size ? bytes : 0;
+}
+
 static bool a50_dma_eligible(struct a50_layer *l)
 {
-	return l->dpp >= 0 &&
-	       !l->src.x && !l->src.y && l->src.w == FB_W && l->src.h == FB_H &&
-	       !l->dst.x && !l->dst.y && l->dst.w == FB_W && l->dst.h == FB_H &&
-	       l->src.f_w == FB_W && l->src.f_h >= FB_H &&
-	       l->buf->size >= (size_t)FB_W * FB_H * 4;
+	return a50_dma_bytes(l) != 0;
+}
+
+static bool a50_scan_range_ok(dma_addr_t start, dma_addr_t end, u64 bytes)
+{
+	/* end is exclusive; address zero is the map-failure sentinel. */
+	return bytes && start && start <= U32_MAX && end >= start &&
+	       end - start >= bytes && bytes <= (u64)U32_MAX - start + 1;
 }
 
