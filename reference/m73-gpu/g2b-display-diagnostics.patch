+static ssize_t g2b_stats_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct a50_decon *d = dev_get_drvdata(dev);
+	ssize_t len;
+	int i;
+
+	if (!d)
+		return -ENODEV;
+	/* No hw_lock: reads must remain available when the update worker is blocked. */
+	len = sysfs_emit(buf, "fence_ctx=%llu fence_seq=%llu pending=%d win_configs=%u scanned=%u copied=%u dma_fallbacks=%u skipped=%u acq_timeouts=%u completed=%u stage=%s worker_seq=%llu worker_layers=%u\n",
