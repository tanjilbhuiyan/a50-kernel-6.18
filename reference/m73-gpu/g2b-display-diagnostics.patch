+		 READ_ONCE(d->win_configs), READ_ONCE(d->scanned), READ_ONCE(d->copied),
+		 READ_ONCE(d->dma_fallbacks), READ_ONCE(d->skipped), READ_ONCE(d->acq_timeouts),
+		 READ_ONCE(d->g2b_completed), READ_ONCE(d->g2b_stage),
+		 (unsigned long long)READ_ONCE(d->g2b_worker_seq), READ_ONCE(d->g2b_worker_layers));
+	for (i = 0; i <= A50_MAX_WIN; i++)
+		len += sysfs_emit_at(buf, len, "layers%d=%u ", i, READ_ONCE(d->g2b_layer_counts[i]));
+	for (i = 0; i < A50_MAX_WIN; i++)
+		len += sysfs_emit_at(buf, len, "worker_format%d=%u ", i, READ_ONCE(d->g2b_formats[i]));
+	return len + sysfs_emit_at(buf, len, "\n");
+}
