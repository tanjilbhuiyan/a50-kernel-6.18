From dce5cdc6e9d1c3cd64f063d5f29e1344e5724756 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Tue, 17 Nov 2026 02:45:25 +0600
Subject: [PATCH] TEST ONLY: M7.3 G2e accept the stock gralloc ION hint flags
 (do not merge)

G2d logged every failing allocation: the stock gralloc allocator asks heap 0
for framebuffer-size buffers with flags 0x48 and small buffers with 0x43,
and the compatibility layer rejected both (-EOPNOTSUPP). 0x8 is
ION_FLAG_NOZEROED, a skip-zeroing hint, ignored here because the native
system heap always zeroes. 0x2 is undefined in Samsung's 4.14 header (older
upstream ION_FLAG_CACHED_NEEDS_SYNC) and ignored by Samsung's ION core;
accepted as a no-op. ION_FLAG_PROTECTED and other bits stay unsupported.
G2d's allocation logging is kept.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Iba9f69807ee0e32fea2273d4f634dbd075bde58a
---
 drivers/staging/android/ion_compat.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/staging/android/ion_compat.c b/drivers/staging/android/ion_compat.c
index 41912abcb..8a12537d2 100644
--- a/drivers/staging/android/ion_compat.c
+++ b/drivers/staging/android/ion_compat.c
@@ -12,6 +12,8 @@
 
 #include "uapi/ion.h"
 
+#define ION_COMPAT_FLAG_NEEDS_SYNC_HINT	2
+
 static int ion_compat_allocate_inner(struct ion_allocation_data *request,
 				     void __user *argument)
 {
@@ -23,7 +25,19 @@ static int ion_compat_allocate_inner(struct ion_allocation_data *request,
 
 	if (!(request->heap_id_mask & BIT(0)))
 		return -ENODEV;
-	if (request->flags & ~(ION_FLAG_CACHED | ION_FLAG_MAY_HWRENDER))
+	/*
+	 * M7.3 G2e: the stock gralloc allocator also passes two hint flags (G2d:
+	 * flags 0x48 for framebuffer-size buffers, 0x43 for small ones):
+	 *  - 0x8 ION_FLAG_NOZEROED (Samsung 4.14 uapi ion.h): skip zeroing. Ignored;
+	 *    every buffer is still zeroed by the native system heap, so the
+	 *    stock "no userspace mapping" restriction is not needed for safety.
+	 *  - 0x2: not defined in Samsung's 4.14 header (older upstream ION's
+	 *    ION_FLAG_CACHED_NEEDS_SYNC); Samsung's ION core ignores unknown bits.
+	 *    Accepted as a no-op; caching follows ION_FLAG_CACHED.
+	 * ION_FLAG_PROTECTED and anything else stay unsupported.
+	 */
+	if (request->flags & ~(ION_FLAG_CACHED | ION_COMPAT_FLAG_NEEDS_SYNC_HINT |
+			       ION_FLAG_NOZEROED | ION_FLAG_MAY_HWRENDER))
 		return -EOPNOTSUPP;
 	if (!request->len)
 		return -EINVAL;
