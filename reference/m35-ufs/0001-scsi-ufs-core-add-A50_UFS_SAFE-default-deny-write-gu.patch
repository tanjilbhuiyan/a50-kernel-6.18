From b7d128a5709f5c2f77ead8a45bba82cebb69a415 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Sun, 8 Nov 2026 14:56:46 +0600
Subject: [PATCH 1/4] scsi: ufs: core: add A50_UFS_SAFE default-deny write
 guard

Galaxy A50 bring-up aid. The UFS device also holds EFS, PARAM and the
bootloader. Only listed non-writing SCSI opcodes and read queries, plus
the fDeviceInit handshake, reach the device; raw UPIU and RPMB requests
are refused. set_disk_ro() is not enough: bio_check_ro() only warns.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ief946b95a2b105561751ee7cff31d93a851747c1
---
 drivers/ufs/core/Kconfig  |  8 ++++
 drivers/ufs/core/ufshcd.c | 83 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 91 insertions(+)

diff --git a/drivers/ufs/core/Kconfig b/drivers/ufs/core/Kconfig
index 817208ee6..6fde40955 100644
--- a/drivers/ufs/core/Kconfig
+++ b/drivers/ufs/core/Kconfig
@@ -8,6 +8,14 @@
 #	Santosh Yaraganavi <santosh.sy@samsung.com>
 #	Vinayak Holikatti <h.vinayak@samsung.com>
 
+config A50_UFS_SAFE
+	bool "Galaxy A50 bring-up: allow only non-writing UFS commands"
+	help
+	  Default-deny guard in the UFS core: only a list of read and power
+	  SCSI opcodes and read queries (plus the fDeviceInit handshake)
+	  reach the device. Bring-up aid for the Samsung Galaxy A50, whose
+	  UFS holds EFS and the bootloader. Say N on anything else.
+
 config SCSI_UFS_BSG
 	bool "Universal Flash Storage BSG device node"
 	select BLK_DEV_BSGLIB
diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index 1a644f25d..3e881a2ec 100644
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -3056,6 +3056,63 @@ static void ufshcd_init_lrb(struct ufs_hba *hba, struct ufshcd_lrb *lrb, int i)
 	lrb->ucd_prdt_dma_addr = cmd_desc_element_addr + prdt_offset;
 }
 
+#ifdef CONFIG_A50_UFS_SAFE
+/*
+ * Galaxy A50 bring-up guard: the UFS device also holds EFS, PARAM and the
+ * bootloader, so nothing may change it until the port is proven. Default deny:
+ * only the SCSI opcodes and query operations listed here reach the device.
+ * set_disk_ro() is not enough, bio_check_ro() only warns.
+ */
+static bool a50_ufs_scsi_allowed(const struct scsi_cmnd *cmd)
+{
+	switch (cmd->cmnd[0]) {
+	case TEST_UNIT_READY:
+	case REQUEST_SENSE:
+	case READ_6:
+	case INQUIRY:
+	case MODE_SENSE:
+	case START_STOP:	/* power state only */
+	case READ_CAPACITY:
+	case READ_10:
+	case MODE_SENSE_10:
+	case READ_16:
+	case REPORT_LUNS:
+		return true;
+	case SERVICE_ACTION_IN_16:
+		return (cmd->cmnd[1] & 0x1f) == SAI_READ_CAPACITY_16;
+	default:
+		return false;
+	}
+}
+
+/* Only reads and the fDeviceInit handshake pass; a blocked write reports success. */
+static bool a50_ufs_query_blocked(struct ufs_hba *hba, enum query_opcode opcode,
+				  u8 idn)
+{
+	switch (opcode) {
+	case UPIU_QUERY_OPCODE_READ_DESC:
+	case UPIU_QUERY_OPCODE_READ_ATTR:
+	case UPIU_QUERY_OPCODE_READ_FLAG:
+		return false;
+	case UPIU_QUERY_OPCODE_SET_FLAG:
+		if (idn == QUERY_FLAG_IDN_FDEVICEINIT)
+			return false;
+		fallthrough;
+	default:
+		dev_warn(hba->dev, "A50_UFS_SAFE: blocked query opcode 0x%x idn 0x%x\n",
+			 opcode, idn);
+		return true;
+	}
+}
+#define A50_UFS_QUERY_GUARD(hba, opcode, idn)				\
+	do {								\
+		if (a50_ufs_query_blocked(hba, opcode, idn))		\
+			return 0;					\
+	} while (0)
+#else
+#define A50_UFS_QUERY_GUARD(hba, opcode, idn) do { } while (0)
+#endif /* CONFIG_A50_UFS_SAFE */
+
 /**
  * ufshcd_queuecommand - main entry point for SCSI requests
  * @host: SCSI host pointer
@@ -3071,6 +3128,16 @@ static int ufshcd_queuecommand(struct Scsi_Host *host, struct scsi_cmnd *cmd)
 	int err = 0;
 	struct ufs_hw_queue *hwq = NULL;
 
+#ifdef CONFIG_A50_UFS_SAFE
+	if (!a50_ufs_scsi_allowed(cmd)) {
+		dev_warn_ratelimited(hba->dev, "A50_UFS_SAFE: blocked SCSI opcode 0x%02x\n",
+				     cmd->cmnd[0]);
+		scsi_build_sense(cmd, 0, ILLEGAL_REQUEST, 0x20, 0);
+		scsi_done(cmd);
+		return 0;
+	}
+#endif
+
 	switch (hba->ufshcd_state) {
 	case UFSHCD_STATE_OPERATIONAL:
 		break;
@@ -3494,6 +3561,8 @@ int ufshcd_query_flag(struct ufs_hba *hba, enum query_opcode opcode,
 	int err, selector = 0;
 	int timeout = dev_cmd_timeout;
 
+	A50_UFS_QUERY_GUARD(hba, opcode, idn);
+
 	BUG_ON(!hba);
 
 	ufshcd_dev_man_lock(hba);
@@ -3563,6 +3632,8 @@ int ufshcd_query_attr(struct ufs_hba *hba, enum query_opcode opcode,
 	struct ufs_query_res *response = NULL;
 	int err;
 
+	A50_UFS_QUERY_GUARD(hba, opcode, idn);
+
 	BUG_ON(!hba);
 
 	if (!attr_val) {
@@ -3666,6 +3737,8 @@ int ufshcd_query_attr_qword(struct ufs_hba *hba, enum query_opcode opcode,
 	struct ufs_query_res *response = NULL;
 	int err;
 
+	A50_UFS_QUERY_GUARD(hba, opcode, idn);
+
 	if (!attr_val) {
 		dev_err(hba->dev, "%s: attribute value required for opcode 0x%x\n",
 			__func__, opcode);
@@ -3719,6 +3792,8 @@ static int __ufshcd_query_descriptor(struct ufs_hba *hba,
 	struct ufs_query_res *response = NULL;
 	int err;
 
+	A50_UFS_QUERY_GUARD(hba, opcode, idn);
+
 	BUG_ON(!hba);
 
 	if (!desc_buf) {
@@ -7774,6 +7849,10 @@ int ufshcd_exec_raw_upiu_cmd(struct ufs_hba *hba,
 	enum utp_ocs ocs_value;
 	u8 tm_f = req_upiu->header.tm_function;
 
+#ifdef CONFIG_A50_UFS_SAFE
+	return -EPERM;
+#endif
+
 	switch (msgcode) {
 	case UPIU_TRANSACTION_NOP_OUT:
 		cmd_type = DEV_CMD_TYPE_NOP;
@@ -7843,6 +7922,10 @@ int ufshcd_advanced_rpmb_req_handler(struct ufs_hba *hba, struct utp_upiu_req *r
 	u16 ehs_len;
 	int ehs = (hba->capabilities & MASK_EHSLUTRD_SUPPORTED) ? 2 : 0;
 
+#ifdef CONFIG_A50_UFS_SAFE
+	return -EPERM;
+#endif
+
 	/* Protects use of hba->reserved_slot. */
 	ufshcd_dev_man_lock(hba);
 
-- 
2.56.0

