From ef9821e5933b826fc459cf6b7ba684c3cf17168f Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Sun, 8 Nov 2026 15:04:03 +0600
Subject: [PATCH 3/4] scsi: ufs: exynos: add Exynos9610 variant

FSD-style sequence with the values of Samsung's ufs-cal-9610.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I97350bfd1976e030a3117f47c9275130f3415be8
---
 .../bindings/ufs/samsung,exynos-ufs.yaml      |   1 +
 drivers/ufs/host/ufs-exynos.c                 | 135 ++++++++++++++++++
 2 files changed, 136 insertions(+)

diff --git a/Documentation/devicetree/bindings/ufs/samsung,exynos-ufs.yaml b/Documentation/devicetree/bindings/ufs/samsung,exynos-ufs.yaml
index b4e744ebf..67eb8eae8 100644
--- a/Documentation/devicetree/bindings/ufs/samsung,exynos-ufs.yaml
+++ b/Documentation/devicetree/bindings/ufs/samsung,exynos-ufs.yaml
@@ -17,6 +17,7 @@ properties:
     enum:
       - google,gs101-ufs
       - samsung,exynos7-ufs
+      - samsung,exynos9610-ufs
       - samsung,exynosautov9-ufs
       - samsung,exynosautov9-ufs-vh
       - tesla,fsd-ufs
diff --git a/drivers/ufs/host/ufs-exynos.c b/drivers/ufs/host/ufs-exynos.c
index 3e50825a7..2d9dd3940 100644
--- a/drivers/ufs/host/ufs-exynos.c
+++ b/drivers/ufs/host/ufs-exynos.c
@@ -2157,6 +2157,139 @@ static struct exynos_ufs_uic_attr fsd_uic_attr = {
 	.pa_dbg_opt_suite1_off		= PA_DBG_OPTION_SUITE,
 };
 
+/*
+ * Exynos9610: link and power-mode settings from Samsung's ufs-cal-9610.c and
+ * ufs-exynos.c (Galaxy A50 kernel). The sequence is close to FSD's, which is the
+ * template here; post_link is identical to the CAL.
+ */
+#define HCI_UFS_ACG_DISABLE		0xfc
+#define HCI_UFS_ACG_DISABLE_EN		BIT(0)
+#define UFS_EXYNOS9610_SHARABLE		(BIT(9) | BIT(8))
+
+static struct exynos_ufs_uic_attr exynos9610_uic_attr = {
+	.tx_trailingclks		= 0x10,
+	.pa_dbg_clk_period_off		= PA_DBG_CLK_PERIOD,
+	.pa_dbg_opt_suite1_val		= 0x2E820183,
+	.pa_dbg_opt_suite1_off		= PA_DBG_OPTION_SUITE,
+};
+
+static int exynos9610_ufs_drv_init(struct exynos_ufs *ufs)
+{
+	return exynos_ufs_shareability(ufs);
+}
+
+/* After every host reset, as the vendor driver does: its HWACG setup is per reset */
+static int exynos9610_ufs_post_hce_enable(struct exynos_ufs *ufs)
+{
+	hci_writel(ufs, hci_readl(ufs, HCI_UFS_ACG_DISABLE) | HCI_UFS_ACG_DISABLE_EN,
+		   HCI_UFS_ACG_DISABLE);
+	hci_writel(ufs, hci_readl(ufs, HCI_IOP_ACG_DISABLE) & ~HCI_IOP_ACG_DISABLE_EN,
+		   HCI_IOP_ACG_DISABLE);
+
+	return 0;
+}
+
+static int exynos9610_ufs_pre_link(struct exynos_ufs *ufs)
+{
+	struct exynos_ufs_uic_attr *attr = ufs->drv_data->uic_attr;
+	struct ufs_hba *hba = ufs->hba;
+	/* the CAL truncates (UNIPRO_MCLK_PERIOD); DIV_ROUND_UP would differ here */
+	u32 period = NSEC_PER_SEC / ufs->mclk_rate;
+	int i;
+
+	/* the lane loops below run before exynos_ufs_phy_init() reads these */
+	ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILRXDATALANES), &ufs->avail_ln_rx);
+	ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILTXDATALANES), &ufs->avail_ln_tx);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(attr->pa_dbg_clk_period_off), period);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x40);
+
+	for_each_ufs_rx_lane(ufs, i)
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x12, i), period);
+	for_each_ufs_tx_lane(ufs, i)
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0xAA, i), period);
+
+	for_each_ufs_rx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x5C, i), 0x38);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x0F, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x65, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x69, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x21, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x22, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x84, i), 0x1);
+	}
+
+	for_each_ufs_tx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x04, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x8F, i), 0x3E);
+	}
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x0);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_DBG_AUTOMODE_THLD), 0x4E20);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(attr->pa_dbg_opt_suite1_off),
+		       attr->pa_dbg_opt_suite1_val);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_LOCAL_TX_LCC_ENABLE), 0x0);
+
+	exynos_ufs_establish_connt(ufs);
+
+	return 0;
+}
+
+static int exynos9610_ufs_pre_pwr_change(struct exynos_ufs *ufs,
+					 struct ufs_pa_layer_attr *pwr)
+{
+	struct ufs_hba *hba = ufs->hba;
+
+	/* Vendor configuration: FAST mode, up to HS-G3, one lane, series B */
+	pwr->gear_rx = min_t(u32, pwr->gear_rx, UFS_HS_G3);
+	pwr->gear_tx = min_t(u32, pwr->gear_tx, UFS_HS_G3);
+	pwr->lane_rx = 1;
+	pwr->lane_tx = 1;
+	pwr->pwr_rx = FAST_MODE;
+	pwr->pwr_tx = FAST_MODE;
+	pwr->hs_rate = PA_HS_MODE_B;
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA0), 12000);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA1), 32000);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA2), 16000);
+
+	/* The CAL only issues these on its second lane pass */
+	if (ufs->avail_ln_rx > 1) {
+		unipro_writel(ufs, 8064, UNIPRO_DME_POWERMODE_REQ_LOCALL2TIMER0);
+		unipro_writel(ufs, 28224, UNIPRO_DME_POWERMODE_REQ_LOCALL2TIMER1);
+		unipro_writel(ufs, 20160, UNIPRO_DME_POWERMODE_REQ_LOCALL2TIMER2);
+		unipro_writel(ufs, 12000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER0);
+		unipro_writel(ufs, 32000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER1);
+		unipro_writel(ufs, 16000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER2);
+	}
+
+	return 0;
+}
+
+static const struct exynos_ufs_drv_data exynos9610_ufs_drvs = {
+	.uic_attr		= &exynos9610_uic_attr,
+	.quirks			= UFSHCD_QUIRK_PRDT_BYTE_GRAN |
+				  UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR |
+				  UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR |
+				  UFSHCD_QUIRK_SKIP_DEF_UNIPRO_TIMEOUT_SETTING |
+				  UFSHCI_QUIRK_SKIP_RESET_INTR_AGGR,
+	/*
+	 * UFSPR_SECURE: leave the UFS protector (SMU) to the bootloader and secure
+	 * world: the vendor kernel sets it up by SMC, not by the register writes in
+	 * exynos_ufs_config_smu().
+	 */
+	.opts			= EXYNOS_UFS_OPT_BROKEN_AUTO_CLK_CTRL |
+				  EXYNOS_UFS_OPT_SKIP_CONFIG_PHY_ATTR |
+				  EXYNOS_UFS_OPT_TIMER_TICK_SELECT |
+				  EXYNOS_UFS_OPT_UFSPR_SECURE,
+	.iocc_mask		= UFS_EXYNOS9610_SHARABLE,
+	.drv_init		= exynos9610_ufs_drv_init,
+	.post_hce_enable	= exynos9610_ufs_post_hce_enable,
+	.pre_link		= exynos9610_ufs_pre_link,
+	.post_link		= fsd_ufs_post_link,
+	.pre_pwr_change		= exynos9610_ufs_pre_pwr_change,
+};
+
 static const struct exynos_ufs_drv_data fsd_ufs_drvs = {
 	.uic_attr               = &fsd_uic_attr,
 	.quirks                 = UFSHCD_QUIRK_PRDT_BYTE_GRAN |
@@ -2198,6 +2331,8 @@ static const struct of_device_id exynos_ufs_of_match[] = {
 	  .data	      = &gs101_ufs_drvs },
 	{ .compatible = "samsung,exynos7-ufs",
 	  .data	      = &exynos_ufs_drvs },
+	{ .compatible = "samsung,exynos9610-ufs",
+	  .data	      = &exynos9610_ufs_drvs },
 	{ .compatible = "samsung,exynosautov9-ufs",
 	  .data	      = &exynosauto_ufs_drvs },
 	{ .compatible = "samsung,exynosautov9-ufs-vh",
-- 
