From bd3fe49b2d2c3b0b04be490b3440d38d806949a3 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Thu, 12 Nov 2026 19:09:16 +0600
Subject: [PATCH] arm64: dts: exynos9610: add isolated DPU SysMMU provider
 probe

Change-Id: I690433748947f4d6e4a3b8817ada0cdd7e996519
---
 arch/arm64/boot/dts/exynos/Makefile           |  1 +
 .../boot/dts/exynos/exynos9610-a50-sysmmu.dts | 28 +++++++++++++++++++
 2 files changed, 29 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos9610-a50-sysmmu.dts

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index 1b136f96a..59c8e0a36 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -14,6 +14,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos850-e850-96.dtb		\
 	exynos8895-dreamlte.dtb		\
 	exynos9610-a50.dtb		\
+	exynos9610-a50-sysmmu.dtb		\
 	exynos9810-starlte.dtb		\
 	exynos990-c1s.dtb		\
 	exynos990-r8s.dtb               \
diff --git a/arch/arm64/boot/dts/exynos/exynos9610-a50-sysmmu.dts b/arch/arm64/boot/dts/exynos/exynos9610-a50-sysmmu.dts
new file mode 100644
index 000000000..a70a31b5b
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9610-a50-sysmmu.dts
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0
+/* M6.3 provider probe. No DMA master is attached to this controller. */
+#include "exynos9610-a50.dts"
+
+&soc {
+	/* Samsung cmucal-sfr.c DISPAUD block, manual CMU mode as in M3.3. */
+	cmu_dispaud: clock-controller@14980000 {
+		compatible = "samsung,exynos9610-cmu-dispaud";
+		reg = <0x14980000 0x8000>;
+		#clock-cells = <1>;
+		clocks = <&oscclk>,
+			 <&cmu_top CLK_DOUT_CMU_DISPAUD_AUD>,
+			 <&cmu_top CLK_DOUT_CMU_DISPAUD_CPU>,
+			 <&cmu_top CLK_DOUT_CMU_DISPAUD_DISP>;
+		clock-names = "oscclk", "dout_cmu_dispaud_aud",
+			      "dout_cmu_dispaud_cpu", "dout_cmu_dispaud_disp";
+	};
+
+	/* Stock DPU SysMMU, first/nonsecure interrupt. DISPAUD stays powered. */
+	sysmmu_dpu: iommu@14820000 {
+		compatible = "samsung,exynos-sysmmu";
+		reg = <0x14820000 0x9000>;
+		interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_SMMU_DPU_CLK>;
+		clock-names = "sysmmu";
+		#iommu-cells = <0>;
+	};
+};
