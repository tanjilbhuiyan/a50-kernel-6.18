 #ifdef CONFIG_A50_DIAG
 	{
 		extern void a50_diag_stage1(void);
@@ -340,6 +363,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	arm64_memblock_init();
 
 	paging_init();
+	a50_rd_mapped("after paging_init");
 
 	acpi_table_upgrade();
 
@@ -350,6 +374,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 		unflatten_device_tree();
 
 	bootmem_init();
+	a50_rd_mapped("after bootmem_init");
 
 	kasan_init();
 
