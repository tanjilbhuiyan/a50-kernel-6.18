From c7002dddaa3e344b9e04524bf4ea3cd75ca0bfa7 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Wed, 18 Nov 2026 14:26:00 +0600
Subject: [PATCH 1/2] arm64: dts: exynos9610-a50: add the volume and power keys

The keys are GPIOs on gpa1 (volume up gpa1-5, volume down gpa1-6, power
gpa1-7), active low with board pull-ups, in external-interrupt mode as in
the stock device tree. The power key is a wakeup source.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ifb8f933793883e61c9924f53c969a2988868856a
---
 arch/arm64/boot/dts/exynos/exynos9610-a50.dts | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
index 7abb415ce..f2af086b0 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
@@ -11,6 +11,7 @@
 
 #include "exynos9610.dtsi"
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
 / {
@@ -32,6 +33,32 @@ / {
 	 * use this fixed clock at the measured PERI bus rate (dout_cmu_peri_bus,
 	 * 66625000 Hz), which is also the stock parent of GATE_I2C_n_QCH.
 	 */
+	/* O: gpio_keys (button@2-4 on gpa1-6/5/7, active low; the power key wakes the system). */
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_pins>;
+
+		key-volume-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
+		};
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+		};
+
+		key-power {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
+
 	peri_bus_bootclk: clock-peri-bus-boot {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
@@ -212,6 +239,14 @@ touchscreen@48 {
 };
 
 &pinctrl_alive {
+	/* O: key-voldown/key-volup/key-power: external interrupt, no pull (pulled up on the board). */
+	key_pins: key-pins {
+		samsung,pins = "gpa1-5", "gpa1-6", "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
 	/* O: mms_ts on_state (attn-irq): gpa0-0 as external interrupt, no pull. */
 	touch_irq_pins: touch-irq-pins {
 		samsung,pins = "gpa0-0";
-- 
