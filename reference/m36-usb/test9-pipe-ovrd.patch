+/* TEST ONLY (M3.6): reads only; the registers captured on the working 4.14 phone. */
+static void a50_dump_regs(void)
+{
+	static const u16 phy_off[] = { 0x04, 0x24, 0x28, 0x30, 0x34, 0x38, 0x3c, 0x48, 0x60 };
+	static const u16 cmu_off[] = { 0x100, 0x108, 0x120, 0x128, 0x140, 0x148, 0x800 };
+	void __iomem *cmu = ioremap(0x13030000, 0x8000);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(phy_off); i++)
+		pr_info("A50 REGS PHY +0x%04x = 0x%08x\n", phy_off[i], readl(a50_phy + phy_off[i]));
+	if (!cmu)
+		return;
+	for (i = 0; i < ARRAY_SIZE(cmu_off); i++)
+		pr_info("A50 REGS CMU +0x%04x = 0x%08x\n", cmu_off[i], readl(cmu + cmu_off[i]));
+	for (i = 0x2000; i <= 0x2048; i += 4)
+		pr_info("A50 REGS CMU +0x%04x = 0x%08x\n", i, readl(cmu + i));
+	iounmap(cmu);
