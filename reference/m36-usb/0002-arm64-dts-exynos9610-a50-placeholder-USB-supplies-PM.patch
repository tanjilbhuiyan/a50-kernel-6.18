From 5bb364deeabc542acd39d68b6ba64fd3929e6d7a Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Sun, 8 Nov 2026 15:46:26 +0600
Subject: [PATCH 2/2] arm64: dts: exynos9610-a50: placeholder USB supplies
 (PMIC not modelled yet)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I4fe62bfbb508a35bbe4115e2894758fe50929903
---
 arch/arm64/boot/dts/exynos/exynos9610-a50.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
index 607865a1b..b9545e9d4 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
@@ -143,3 +143,20 @@ chub@fd000000 {
 		};
 	};
 };
+
+/*
+ * Placeholder until the PMIC is modelled (M4): the binding requires these
+ * supplies, and the stock DT gives the USB nodes no supply either, so Samsung's
+ * USB driver does not switch them.
+ */
+/ {
+	reg_dummy: regulator-dummy {
+		compatible = "regulator-fixed";
+		regulator-name = "dummy";
+	};
+};
+
+&usbdrd {
+	vdd10-supply = <&reg_dummy>;
+	vdd33-supply = <&reg_dummy>;
+};
-- 
2.56.0

