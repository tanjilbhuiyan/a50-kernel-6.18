From 33c851162603f15d9d01baa4b7fba27cf19b7126 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Thu, 12 Nov 2026 18:25:13 +0600
Subject: [PATCH] staging: add Exynos ION system heap ABI on native DMA heaps

Provide the measured fixed-layout allocation and query ioctls, with cached and uncached native system heap backing and copyout-safe fd installation. Adapt Samsung tracking hints to separate counters in native task buffer accounting records.

Change-Id: Id754f153b14fe5a2c6e71e05eca6d5b1f5337ebe
---
 drivers/dma-buf/dma-buf.c            |  42 +++++++
 drivers/staging/Makefile             |   2 +-
 drivers/staging/android/Kconfig      |  10 ++
 drivers/staging/android/Makefile     |   1 +
 drivers/staging/android/ion_compat.c | 120 ++++++++++++++++++
 drivers/staging/android/uapi/ion.h   | 178 +++++++++++++++++++++++++++
 include/linux/dma-buf.h              |   4 +
 7 files changed, 356 insertions(+), 1 deletion(-)
 create mode 100644 drivers/staging/android/ion_compat.c
 create mode 100644 drivers/staging/android/uapi/ion.h

diff --git a/drivers/dma-buf/dma-buf.c b/drivers/dma-buf/dma-buf.c
index 8e379f21b..aabc6ea40 100644
--- a/drivers/dma-buf/dma-buf.c
+++ b/drivers/dma-buf/dma-buf.c
@@ -358,6 +358,9 @@ static void add_task_dmabuf_record(struct task_dma_buf_info *dmabuf_info,
 
 	rec->dmabuf = dmabuf;
 	rec->refcnt = 1;
+#ifdef CONFIG_ION_EXYNOS_COMPAT
+	rec->ion_legacy_refs = 0;
+#endif
 	list_add(&rec->node, &dmabuf_info->dmabufs);
 	dmabuf_info->dmabuf_count++;
 	dmabuf_info->rss += dmabuf->size;
@@ -1136,6 +1139,39 @@ static long dma_buf_import_sync_file(struct dma_buf *dmabuf,
 }
 #endif
 
+#ifdef CONFIG_ION_EXYNOS_COMPAT
+#define ION_DMA_BUF_TRACK _IO('b', 8)
+#define ION_DMA_BUF_UNTRACK _IO('b', 9)
+
+static int dma_buf_ion_track(struct dma_buf *dmabuf, bool track)
+{
+	struct task_dma_buf_info *info = current->dmabuf_info;
+	struct task_dma_buf_record *record;
+	int result = 0;
+
+	if (!is_dmabuf_accounting_enabled())
+		return -EOPNOTSUPP;
+	if (!info)
+		return -ESRCH;
+	spin_lock(&info->lock);
+	record = find_task_dmabuf_record(info, dmabuf);
+	if (!record) {
+		result = -ENOENT;
+	} else if (track) {
+		if (record->ion_legacy_refs == UINT_MAX)
+			result = -EOVERFLOW;
+		else
+			record->ion_legacy_refs++;
+	} else if (record->ion_legacy_refs) {
+		record->ion_legacy_refs--;
+	} else {
+		result = -ENOENT;
+	}
+	spin_unlock(&info->lock);
+	return result;
+}
+#endif
+
 static long dma_buf_ioctl(struct file *file,
 			  unsigned int cmd, unsigned long arg)
 {
@@ -1147,6 +1183,12 @@ static long dma_buf_ioctl(struct file *file,
 	dmabuf = file->private_data;
 
 	switch (cmd) {
+#ifdef CONFIG_ION_EXYNOS_COMPAT
+	case ION_DMA_BUF_TRACK:
+		return dma_buf_ion_track(dmabuf, true);
+	case ION_DMA_BUF_UNTRACK:
+		return dma_buf_ion_track(dmabuf, false);
+#endif
 	case DMA_BUF_IOCTL_SYNC:
 		if (copy_from_user(&sync, (void __user *) arg, sizeof(sync)))
 			return -EFAULT;
