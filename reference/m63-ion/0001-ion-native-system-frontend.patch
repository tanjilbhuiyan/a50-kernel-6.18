diff --git a/drivers/staging/android/Kconfig b/drivers/staging/android/Kconfig
index b432280be..eb1d974c1 100644
--- a/drivers/staging/android/Kconfig
+++ b/drivers/staging/android/Kconfig
@@ -1,4 +1,14 @@
 # SPDX-License-Identifier: GPL-2.0
+config ION_EXYNOS_COMPAT
+	bool "Exynos ION userspace compatibility on native DMA heaps"
+	depends on ARM64
+	select DMABUF_HEAPS
+	select DMABUF_HEAPS_SYSTEM
+	help
+	  Provide the ION allocation and heap-query ABI used by Exynos Android
+	  userspace. System allocations use the native cached and uncached DMA
+	  heaps. Reserved and protected Exynos heaps are not implemented.
+
 config ASHMEM
 	bool "Enable the Anonymous Shared Memory Subsystem"
 	depends on SHMEM && RUST
diff --git a/drivers/staging/android/Makefile b/drivers/staging/android/Makefile
index 0732228e3..3a9335ea7 100644
--- a/drivers/staging/android/Makefile
+++ b/drivers/staging/android/Makefile
@@ -2,3 +2,4 @@
