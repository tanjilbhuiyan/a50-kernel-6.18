diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index e63b98d46..1e80e932c 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2184,6 +2184,13 @@ config SND_SOC_TDA7419
 	depends on I2C
 	select REGMAP_I2C
 
+config SND_SOC_TFA9872
+	tristate "NXP TFA9872 (Samsung A50) amplifier"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Samsung/NXP TFA9872 with external ABOX DSP. No EFS file I/O.
+
