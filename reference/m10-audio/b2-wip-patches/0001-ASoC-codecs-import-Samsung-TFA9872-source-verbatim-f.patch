+	handles_local[dev_idx].daimap = TFA98XX_DAI_I2S; /* all others */
+	handles_local[dev_idx].spkr_count = 1;
+	handles_local[dev_idx].spkr_select = 0;
+	handles_local[dev_idx].spkr_damaged = 0;
