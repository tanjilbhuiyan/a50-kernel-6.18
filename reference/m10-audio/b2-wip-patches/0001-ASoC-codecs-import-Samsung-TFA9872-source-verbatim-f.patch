+	tfa98xx_close(tfa98xx->handle);
+	mutex_unlock(&tfa98xx->dsp_lock);
+
+	if (mtpex->deferrable) {
+		if (err != TFA98XX_ERROR_OK && err != TFA98XX_ERROR_NO_CLOCK) {
