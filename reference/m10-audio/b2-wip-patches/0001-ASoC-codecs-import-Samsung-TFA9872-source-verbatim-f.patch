+/*
+ * Get the name of the device at a certain index in the container file
+ * return device name
+ */
+char *tfa_cont_device_name(int dev_idx)
+{
+	struct tfa_device_list *dev;
+
+	if (dev_idx >= tfa98xx_cnt_max_device())
+		return ERROR_STRING;
+
+	dev = tfa_cont_device(dev_idx);
+	if (dev == NULL)
+		return ERROR_STRING;
