+static int tfa98xx_ext_reset(struct tfa98xx *tfa98xx)
+{
+	if (tfa98xx && gpio_is_valid(tfa98xx->reset_gpio)) {
+		gpio_set_value_cansleep(tfa98xx->reset_gpio, 1);
+		gpio_set_value_cansleep(tfa98xx->reset_gpio, 0);
+	}
+	return 0;
+}
