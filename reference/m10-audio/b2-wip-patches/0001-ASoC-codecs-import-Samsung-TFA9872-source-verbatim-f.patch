+
+uint32_t crc32_le(uint32_t crc, unsigned char const *buf, size_t len)
+{
+	const uint8_t *p;
+
+	p = buf;
+
+	while (len--)
+		crc = crc32_tab[(crc ^ *p++) & 0xFF] ^ (crc >> 8);
+
+	return crc;
+}
diff --git a/sound/soc/codecs/tfa9872/tfa_debug.c b/sound/soc/codecs/tfa9872/tfa_debug.c
