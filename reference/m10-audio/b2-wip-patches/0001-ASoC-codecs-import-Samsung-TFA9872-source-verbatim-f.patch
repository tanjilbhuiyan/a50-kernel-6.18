+		reg_write(handle, 0x71, 0x3074); /* POR=0x2074 */
+		reg_write(handle, 0x75, 0x4484); /* POR=0x4585 */
+		reg_write(handle, 0x76, 0x72ea); /* POR=0x54a2 */
+		reg_write(handle, 0x82, 0x024d); /* POR=0x000d */
+		reg_write(handle, 0x89, 0x0013); /* POR=0x0014 */
