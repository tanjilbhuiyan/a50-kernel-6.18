+	if (sync->poisoned) {
+		ret = -EIO;
+		goto unlock;
 	}
-
-	abox_request_cpu_gear(&data->pdev_abox->dev, aboxdata,
-					REALTIME_GEAR_ID, 4);
-
-	tfadrv_write_buf = (char *)buf;
-	smem_write_buf = (char *)abox_addr_to_kernel_addr(aboxdata, SMEM_WRITE);
-
-	msg.ipcid = IPC_ERAP;
-	erap_msg->msgtype = REALTIME_EXTRA;
-	erap_msg->param.raw.params[0] = TFADSP_CMD_WRITE;
-	erap_msg->param.raw.params[1] = size;
-
-	memcpy(smem_write_buf, tfadrv_write_buf, size);
-	abox_ipc_write_avail = false;
-	abox_ipc_write_error = TFADSP_SUCCESS;
-
-	ret = abox_start_ipc_transaction(&data->pdev_abox->dev, IPC_ERAP,
-					&msg, sizeof(msg), 1, 1);
-	if (ret < 0) {
-		ipc_err("abox_start_ipc_transaction is failed, error=%d", ret);
-		/*return -1;*/
+	ret = pm_runtime_resume_and_get(sync->abox_dev);
+	if (ret < 0)
+		goto unlock;
+	if (!READ_ONCE(sync->abox->calliope_version)) {
+		ret = -EAGAIN;
+		goto put_pm;
 	}
-
-	ret = wait_event_interruptible_timeout(wq_write,
-		abox_ipc_write_avail, msecs_to_jiffies(TIMEOUT_MS));
-
-	abox_request_cpu_gear(&data->pdev_abox->dev, aboxdata,
-					REALTIME_GEAR_ID, 12);
-
-	if (!ret) {
-		ipc_err("wait_event timeout");
-		abox_ipc_timeout_state = true;
-		return 0;
+	area = abox_tfa_window(sync, is_read ? TFA_SMEM_READ : TFA_SMEM_WRITE,
+			       bytes);
+	if (IS_ERR(area)) {
+		ret = PTR_ERR(area);
+		goto put_pm;
 	}
-	if (abox_ipc_write_error) {
-		ipc_err("abox_ipc_write_error = %d", abox_ipc_write_error);
-		return -1;
+	if (!is_read) {
+		memcpy(area, write, bytes);
+		wmb();
 	}
-	return 0;
+	reinit_completion(&sync->reply);
+	spin_lock_irqsave(&sync->reply_lock, flags);
+	sync->expected_reply = is_read ? TFA_RES_READ : TFA_RES_WRITE;
+	sync->expected_bytes = bytes;
+	sync->result = -EINPROGRESS;
+	sync->pending = true;
+	spin_unlock_irqrestore(&sync->reply_lock, flags);
+	msg.msg.erap.msgtype = REALTIME_EXTRA;
+	msg.msg.erap.param.raw.params[0] = is_read ? TFA_CMD_READ : TFA_CMD_WRITE;
+	msg.msg.erap.param.raw.params[1] = bytes;
+	ret = abox_start_ipc_transaction(sync->abox_dev, IPC_ERAP, &msg,
+					 sizeof(msg), 0, 1);
+	if (!ret && !wait_for_completion_timeout(&sync->reply,
+					msecs_to_jiffies(TFA_TIMEOUT_MS)))
+		ret = -ETIMEDOUT;
+	spin_lock_irqsave(&sync->reply_lock, flags);
+	if (ret) {
+		/* Sending or waiting may have failed after firmware accepted it. */
+		sync->poisoned = true;
+	} else {
+		ret = sync->result;
+		if (!ret && is_read)
+			memcpy(read, sync->read_buffer, bytes);
+	}
+	sync->pending = false;
+	spin_unlock_irqrestore(&sync->reply_lock, flags);
+put_pm:
+	pm_runtime_mark_last_busy(sync->abox_dev);
+	pm_runtime_put_autosuspend(sync->abox_dev);
+unlock:
+	mutex_unlock(&sync->transfer_lock);
+	return ret;
 }
