+static irqreturn_t abox_tfa_reply(int irq, void *cookie, ABOX_IPC_MSG *msg)
+{
+	struct abox_tfa_sync *sync = cookie;
+	u32 response = msg->msg.erap.param.raw.params[0];
+	u32 bytes = msg->msg.erap.param.raw.params[1];
+	unsigned long flags;
+	void *area;
+
+	if (irq != IPC_ERAP || msg->msg.erap.msgtype != REALTIME_EXTRA)
+		return IRQ_NONE;
+	spin_lock_irqsave(&sync->reply_lock, flags);
+	if (!sync->pending || sync->poisoned)
+		goto out;
+	if (response == TFA_WRITE_INVALID || response == TFA_READ_INVALID ||
+	    response == TFA_INVALID_PARAM || response == TFA_FAILED) {
+		sync->result = -EREMOTEIO;
+	} else if (response != sync->expected_reply) {
+		sync->result = -EPROTO;
+		sync->poisoned = true;
+	} else if (response == TFA_RES_READ) {
+		if (bytes != sync->expected_bytes) {
+			sync->result = -EMSGSIZE;
+		} else {
+			area = abox_tfa_window(sync, TFA_SMEM_READ, bytes);
+			if (IS_ERR(area)) {
+				sync->result = PTR_ERR(area);
+			} else {
+				rmb();
+				memcpy(sync->read_buffer, area, bytes);
+				sync->result = 0;
+			}
+		}
+	} else {
+		sync->result = 0;
 	}
+	sync->pending = false;
+	complete(&sync->reply);
+out:
+	spin_unlock_irqrestore(&sync->reply_lock, flags);
 	return IRQ_HANDLED;
 }
 
