-static void samsung_abox_synchronized_ipc_remove(struct platform_device *pdev)
-{
-	snd_soc_unregister_platform(&pdev->dev);
+	/* IRQ cookie lives as long as ABOX's own handler list. */
+	sync = devm_kzalloc(&parent->dev, sizeof(*sync), GFP_KERNEL);
+	if (!sync) {
+		put_device(&parent->dev);
+		return -ENOMEM;
+	}
+	sync->abox_dev = &parent->dev;
+	sync->abox = platform_get_drvdata(parent);
+	mutex_init(&sync->transfer_lock);
+	spin_lock_init(&sync->reply_lock);
+	init_completion(&sync->reply);
+	ret = abox_register_irq_handler(sync->abox_dev, IPC_ERAP,
+					abox_tfa_reply, sync);
+	if (!ret) {
+		WRITE_ONCE(tfa_sync, sync);
+		ret = tfa_ext_register(abox_tfa_write, abox_tfa_read, NULL);
+	}
+	put_device(&parent->dev);
+	if (ret)
+		return ret;
+	dev_info(&pdev->dev, "TFA external DSP transport ready (8 KiB windows)\n");
+	return 0;
 }
 
