+/* sound/soc/samsung/abox/abox_effect.c
+ *
+ * ALSA SoC Audio Layer - Samsung Abox Effect driver
+ *
+ * Copyright (c) 2016 Samsung Electronics Co. Ltd.
+ *
+ * This program is free software; you can redistribute it and/or modify
