+static void abox_pad_retention(bool retention)
+{
+	if (retention) {
+		pr_debug("%s:Do not need\n", __func__);
+	} else {
+#ifndef EMULATOR
+		exynos_pmu_update(PAD_RETENTION_ABOX_OPTION,
+				0x10000000, 0x10000000);
+#else
+		update_mask_value(pmu_alive + PAD_RETENTION_ABOX_OPTION,
+				0x10000000, 0x10000000);
+#endif
+	}
+}
