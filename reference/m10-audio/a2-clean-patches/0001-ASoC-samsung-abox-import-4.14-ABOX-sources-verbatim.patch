+
+#ifndef __SND_SOC_ABOX_IF_H
+#define __SND_SOC_ABOX_IF_H
+
+#include "abox.h"
+
+enum abox_if_config {
+	ABOX_IF_WIDTH,
+	ABOX_IF_CHANNEL,
+	ABOX_IF_RATE,
+	ABOX_IF_FMT_COUNT,
+};
+
+struct abox_if_of_data {
+	enum abox_dai (*get_dai_id)(int id);
+	const char *(*get_dai_name)(int id);
+	const char *(*get_str_name)(int id, int stream);
