+	SOC_SINGLE_EXT("%s channel", ABOX_IF_CHANNEL, 0, 8, 0,
+			abox_if_config_get, abox_if_config_put),
+	SOC_SINGLE_EXT("%s rate", ABOX_IF_RATE, 0, 384000, 0,
+			abox_if_config_get, abox_if_config_put),
+};
