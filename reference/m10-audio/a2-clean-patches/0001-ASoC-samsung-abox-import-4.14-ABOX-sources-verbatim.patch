+	.probe		= abox_rdma_probe,
+	.remove		= abox_rdma_remove,
+	.compr_ops	= &abox_rdma_compr_ops,
+	.ops		= &abox_rdma_ops,
+	.pcm_new	= abox_rdma_new,
+	.pcm_free	= abox_rdma_free,
+};
