+	int param1;
+	int param2;
+};
+
+/******** ABOX_ASB_TEST IPC ***********************/
+enum ABOX_TEST_MSG {
+	ASB_MULTITX_SINGLERX = 1,
+	ASB_SINGLETX_MULTIRX,
+	ASB_MULTITX_MULTIRX,
