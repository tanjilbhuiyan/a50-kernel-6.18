From cdd3e5c75101f2e1c195a0f542206077cb30c558 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Fri, 20 Nov 2026 19:05:54 +0600
Subject: [PATCH 5/7] ASoC: samsung: abox: keep the ABOX CPU at its bootloader
 clock on 6.18

Stock reaches the faster ABOX CPU gears (up to 1.18 GHz) through ACPM
DVFS, which raises the AUD voltage before the frequency. 6.18 has no AUD
DVFS, so raising the ABOX CPU (and with it its ACLK) at the boot voltage
is unsafe. Keep the bootloader rate (AUD PLL / 3 = 393 MHz, the lowest
stock DVFS level, measured on the phone in M10.2 A1r2) and only record
gear requests and report the actual rate to the firmware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I47413d056d98b3fd2e7432df86f1b77a563c79a9
---
 sound/soc/samsung/abox/abox.c | 27 +++++----------------------
 1 file changed, 5 insertions(+), 22 deletions(-)

diff --git a/sound/soc/samsung/abox/abox.c b/sound/soc/samsung/abox/abox.c
index afab77ae5..d6f2ff4bd 100644
--- a/sound/soc/samsung/abox/abox.c
+++ b/sound/soc/samsung/abox/abox.c
@@ -3433,7 +3433,6 @@ static void abox_change_cpu_gear_legacy(struct device *dev,
 {
 	struct abox_qos_request *request;
 	unsigned int gear = UINT_MAX;
-	int ret;
 	bool increasing;
 
 	dev_dbg(dev, "%s\n", __func__);
@@ -3465,28 +3464,12 @@ static void abox_change_cpu_gear_legacy(struct device *dev,
 	}
 
 	/*
-	 * 6.18: the common clock framework works in Hz (the 4.14 legacy path
-	 * passed kHz and asked for PLL rate 0 as a bypass, which the mainline
-	 * PLL cannot do). Idle gears leave the clocks as they are; active
-	 * gears run the AUD PLL at its 48 kHz-family rate and divide the ABOX
-	 * CPU clock from it.
+	 * 6.18: no AUD DVFS. On stock the faster gears (up to 1.18 GHz) are
+	 * reached through ACPM DVFS, which raises the AUD voltage first; this
+	 * kernel cannot scale that voltage, so the ABOX CPU stays at the
+	 * bootloader rate (AUD PLL / 3 = 393 MHz, stock's lowest DVFS level)
+	 * and gear requests are only recorded and reported to the firmware.
 	 */
-	if (gear < ABOX_CPU_GEAR_MIN) {
-		if (clk_get_rate(data->clk_pll) != AUD_PLL_RATE_HZ_FOR_48000) {
-			ret = clk_set_rate(data->clk_pll,
-					AUD_PLL_RATE_HZ_FOR_48000);
-			if (ret < 0)
-				dev_warn(dev, "setting pll clock failed: %d\n",
-						ret);
-			dev_info(dev, "pll clock: %lu\n",
-					clk_get_rate(data->clk_pll));
-		}
-		ret = clk_set_rate(data->clk_cpu,
-				clk_get_rate(data->clk_pll) / gear);
-		if (ret < 0)
-			dev_warn(dev, "setting cpu clock gear to %d is failed: %d\n",
-					gear, ret);
-	}
 	dev_info(dev, "cpu clock: %luHz (gear %u)\n",
 			clk_get_rate(data->clk_cpu), gear);
 
