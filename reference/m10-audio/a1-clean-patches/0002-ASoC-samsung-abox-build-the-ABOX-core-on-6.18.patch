+int abox_dapm_connected_ep(struct snd_soc_dapm_widget *w,
+		enum snd_soc_dapm_direction dir, struct list_head *list)
+{
+	enum snd_soc_dapm_direction rdir = (dir == SND_SOC_DAPM_DIR_IN) ?
+			SND_SOC_DAPM_DIR_OUT : SND_SOC_DAPM_DIR_IN;
+	struct snd_soc_dapm_path *path;
+	int con = 0;
+
+	if (w->endpoints[dir] >= 0)
+		return w->endpoints[dir];
+
+	if (list)
+		list_add_tail(&w->work_list, list);
+
+	if ((w->is_ep & SND_SOC_DAPM_DIR_TO_EP(dir)) && w->connected) {
+		w->endpoints[dir] = 1;
+		return 1;
+	}
+
+	snd_soc_dapm_widget_for_each_path(w, rdir, path) {
+		if (path->is_supply)
+			continue;
+		if (path->walking)
+			return 1;
+		if (path->connect) {
+			path->walking = 1;
+			con += abox_dapm_connected_ep(path->node[dir], dir, list);
+			path->walking = 0;
+		}
+	}
+
+	w->endpoints[dir] = con;
+	return con;
+}
