+/*
+ * 6.18 forward-port shims.
+ *
+ * Secure calls: Samsung's abox_smc() is a plain SMC; use the SMCCC helper.
+ * PMU: Samsung's exynos_pmu_*() accessors become the PMU syscon regmap.
+ * PM QoS: Samsung's INT/MIF/CPU-cluster QoS classes have no 6.18 provider (no
+ * DVFS yet); requests are only recorded. The ABOX CPU clock is set directly
+ * (abox_change_cpu_gear_legacy()).
+ * VTS: the A50 has no VTS block (no "share vts sram" quirk), so the SRAM
+ * sharing calls are never reached.
+ */
+/* Samsung added SND_SOC_DAPM_DEMUX_E to the 4.14 soc-dapm.h */
+#define SND_SOC_DAPM_DEMUX_E(wname, wreg, wshift, winvert, wcontrols, \
+	wevent, wflags) \
+{	.id = snd_soc_dapm_demux, .name = wname, \
+	SND_SOC_DAPM_INIT_REG_VAL(wreg, wshift, winvert), \
+	.kcontrol_news = wcontrols, .num_kcontrols = 1, \
+	.event = wevent, .event_flags = wflags}
+
+static struct regmap *abox_pmu;
+
+static int abox_pmu_read(unsigned int offset, unsigned int *val)
+{
+	return regmap_read(abox_pmu, offset, val);
+}
+
+static int abox_pmu_write(unsigned int offset, unsigned int val)
+{
+	return regmap_write(abox_pmu, offset, val);
+}
+
+static int abox_pmu_update(unsigned int offset, unsigned int mask,
+		unsigned int val)
+{
+	return regmap_update_bits(abox_pmu, offset, mask, val);
+}
+
+struct abox_qos_req {
+	int pm_qos_class;
+	s32 value;
+};
+
+static void abox_qos_add(struct abox_qos_req *req, int pm_qos_class, s32 value)
+{
+	req->pm_qos_class = pm_qos_class;
+	req->value = value;
+}
+
+static void abox_qos_update(struct abox_qos_req *req, s32 value)
+{
+	req->value = value;
+}
+
+static s32 abox_qos_value(struct abox_qos_req *req)
+{
+	return req->value;
+}
+
+static inline void abox_qos_remove(struct abox_qos_req *req) {}
+
+enum { ABOX_QOS_AUD, ABOX_QOS_INT, ABOX_QOS_MIF, ABOX_QOS_LIT, ABOX_QOS_BIG };
+
+static inline int vts_acquire_sram(struct platform_device *pdev, int vts) { return 0; }
+static inline int vts_release_sram(struct platform_device *pdev, int vts) { return 0; }
+
 #undef EMULATOR
 #ifdef EMULATOR
 static void __iomem *pmu_alive;
