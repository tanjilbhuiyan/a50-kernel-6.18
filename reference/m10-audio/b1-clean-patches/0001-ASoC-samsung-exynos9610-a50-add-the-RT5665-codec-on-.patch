+/*
+ * As stock: keep the UAIF0 bit clock running (Q-channel off) while a
+ * stream uses it, and lock the codec PLL to it (system clock = 512 fs).
+ */
+static int a50_uaif0_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct a50_card *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	unsigned int bclk = params_rate(params) * params_channels(params) *
+			    params_width(params);
+	unsigned int sysclk = params_rate(params) * 512;
+	int ret;
+
+	if (!priv->uaif0_streams)
+		snd_soc_dai_set_tristate(cpu_dai, 0);
+	priv->uaif0_streams |= BIT(substream->stream);
+
+	ret = snd_soc_dai_set_pll(codec_dai, 0, RT5665_PLL1_S_BCLK1, bclk,
+				  sysclk);
+	if (ret < 0) {
+		dev_err(rtd->dev, "codec PLL %u -> %u: %d\n", bclk, sysclk,
+			ret);
+		return ret;
+	}
+
+	return snd_soc_dai_set_sysclk(codec_dai, RT5665_SCLK_S_PLL1, sysclk,
+				      SND_SOC_CLOCK_IN);
+}
+
+static int a50_uaif0_hw_free(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct a50_card *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	priv->uaif0_streams &= ~BIT(substream->stream);
+	if (!priv->uaif0_streams)
+		snd_soc_dai_set_tristate(snd_soc_rtd_to_cpu(rtd, 0), 1);
+
+	return 0;
+}
+
+static const struct snd_soc_ops a50_uaif0_ops = {
+	.hw_params = a50_uaif0_hw_params,
+	.hw_free = a50_uaif0_hw_free,
+};
+
+/* Stock "Sound Wakelock": the HAL holds the system awake while playing. */
+static int a50_wakelock_get(struct snd_kcontrol *kcontrol,
+			    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct a50_card *priv = snd_soc_card_get_drvdata(card);
+
+	ucontrol->value.integer.value[0] = priv->wakelock;
+
+	return 0;
+}
+
+static int a50_wakelock_put(struct snd_kcontrol *kcontrol,
+			    struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct a50_card *priv = snd_soc_card_get_drvdata(card);
+	bool on = ucontrol->value.integer.value[0];
+
+	if (on == priv->wakelock)
+		return 0;
+	priv->wakelock = on;
+	if (on)
+		__pm_stay_awake(priv->ws);
+	else
+		__pm_relax(priv->ws);
+
+	return 1;
+}
+
+static const struct snd_kcontrol_new a50_controls[] = {
