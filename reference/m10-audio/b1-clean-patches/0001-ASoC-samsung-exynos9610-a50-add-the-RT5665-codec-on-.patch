+	SOC_DAPM_PIN_SWITCH("SUBMIC"),
+	SOC_DAPM_PIN_SWITCH("HEADSETMIC"),
+	SOC_SINGLE_BOOL_EXT("Sound Wakelock", 0, a50_wakelock_get,
+			    a50_wakelock_put),
+};
