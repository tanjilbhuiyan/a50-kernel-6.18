+		mutex_unlock(&active_mxman->mxman_mutex);
+		SCSC_TAG_INFO(MXMAN, "Called during error - ignore\n");
+		return ret;
+	}
+
+	if (active_mxman->mxman_state == MXMAN_STATE_STARTED) {
