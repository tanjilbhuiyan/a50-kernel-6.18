+
+/**
+ * Time stamp
+ */
+struct slsi_kic_timestamp {
+	uint64_t tv_sec;  /* seconds */
+	uint64_t tv_nsec; /* nanoseconds */
+};
+
+/* Policy */
+enum slsi_kic_attr_timestamp_attributes {
