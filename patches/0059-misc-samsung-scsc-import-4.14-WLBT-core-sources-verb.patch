+	if (kobj_ref) {
+		/* Create sysfs file /sys/wifi/memdump */
+		r = sysfs_create_file(kobj_ref, &memdump_attr.attr);
+		if (r) {
+			/* Failed, so clean up dir */
+			SCSC_TAG_ERR(MXMAN, "Can't create /sys/wifi/memdump\n");
+			mxman_wifi_kobject_ref_put();
