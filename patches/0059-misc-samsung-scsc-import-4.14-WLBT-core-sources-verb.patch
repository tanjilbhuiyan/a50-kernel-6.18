+		kobject_put(wifi_kobj_ref);
+		kobject_uevent(wifi_kobj_ref, KOBJ_REMOVE);
+		wifi_kobj_ref = NULL;
+		WARN_ON(refcount < 0);
+	}
+}
+EXPORT_SYMBOL(mxman_wifi_kobject_ref_put);
