+/* EXTEND PROC ENTRIES IF NEEDED!!!!! */
+static struct scsc_mif_abs *mif_global;
+
+static int mifprocfs_open_file_generic(struct inode *inode, struct file *file)
+{
+	file->private_data = MIF_PDE_DATA(inode);
