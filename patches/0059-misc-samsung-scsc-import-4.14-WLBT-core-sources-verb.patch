+		 * MM_MSG_HALT_RSP is not implemented in all versions of firmware, so don't treat it's non-arrival
+		 * as an error
+		 */
+		SCSC_TAG_INFO(MXMAN, "wait_for_MM_HALT_RSP completed");
+	}
+
+	return 0;
+}
