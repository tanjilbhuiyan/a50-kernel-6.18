+/*
+ * Check for matching f/w and h/w
+ *
+ * Returns	0:  f/w and h/w match
+ *		1:  f/w and h/w mismatch, try the next config
+ *		-ve fatal error
+ */
+static int mxman_hw_ver_check(struct mxman *mxman)
+{
+	if (mx140_file_supported_hw(mxman->mx, mxman->rf_hw_ver))
+		return 0;
+	else
+		return 1;
+}
