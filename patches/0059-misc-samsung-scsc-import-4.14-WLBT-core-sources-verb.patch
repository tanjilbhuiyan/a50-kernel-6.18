+	return simple_read_from_buffer(user_buf, count, ppos, buf, pos);
+}
+
+static ssize_t mifprocfs_mif_dump_read(struct file *file, char __user *user_buf, size_t count, loff_t *ppos)
+{
+	char         buf[128];
+	int          pos = 0;
+	const size_t bufsz = sizeof(buf);
+
