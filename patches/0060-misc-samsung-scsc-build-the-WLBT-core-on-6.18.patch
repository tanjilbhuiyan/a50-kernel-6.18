+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung SCSC (Maxwell) Wi-Fi/Bluetooth core, reduced for the 6.18 A50 port.
+# Only the Exynos 9610 platform interface and the core manager are built;
+# PCIe, logring, log collection, PM QoS, smapper, wlbtd and debug devices of
+# the 4.14 driver are not ported.
+
+config SCSC_CORE
+	tristate "Samsung SCSC (Maxwell) Wi-Fi/Bluetooth core"
+	depends on ARCH_EXYNOS && OF_RESERVED_MEM && MFD_SYSCON && HAVE_ARM_SMCCC
+	help
+	  Core manager for the Samsung SCSC Wi-Fi/Bluetooth chip integrated in
+	  Exynos 9610: shared memory, mailboxes, firmware loading and the
+	  service manager used by the Wi-Fi and Bluetooth drivers.
+
+if SCSC_CORE
+
+config SCSC_PLATFORM_EXYNOS9610
+	bool "Exynos 9610 platform interface"
+	default y
+	help
+	  PMU power/reset sequence, bus access windows and interrupts of the
+	  WLBT block in Exynos 9610.
+
+config SCSC_WLBT_CONFIG_PLATFORM
+	string "WLBT platform name"
+	default "leman_s620_univ"
+
+config SCSC_CORE_FW_LOCATION
+	string "Firmware directory"
+	default "/vendor/etc/wifi"
+
+config SCSC_CORE_TOOL_LOCATION
+	string "Userspace tool directory"
+	default "/vendor/bin"
+
+config SCSC_CM_MX_CLIENT_TEST
+	tristate "Test client (NULL service)"
+	help
+	  Client that can boot the chip with the NULL service, without the
+	  Wi-Fi or Bluetooth drivers. Used for bring-up.
+
+config SCSC_MX_ALWAYS_ON
+	bool "Boot the chip from the test client after a delay"
+	depends on SCSC_CM_MX_CLIENT_TEST
+	help
+	  Start the NULL service about 30 s after the core probes.
+
+endif
