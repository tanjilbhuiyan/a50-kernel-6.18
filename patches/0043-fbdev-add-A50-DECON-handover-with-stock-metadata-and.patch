@@ -45,6 +45,25 @@ menuconfig FB
 	  (e.g. an accelerated X server) and that are not frame buffer
 	  device-aware may cause unexpected results. If unsure, say N.
 
+config FB_A50_HANDOVER
+	bool "Samsung Galaxy A50 bootloader display handover"
+	depends on FB && ARM64 && OF && DMA_SHARED_BUFFER && IOMMU_API
+	select FB_IOMEM_HELPERS
+	help
+	  Preserve S-Boot's Exynos9610/EA8076 display setup and provide the
+	  measured stock fbdev metadata, WIN_CONFIG, fence and blanking ABI.
+	  Supports one full-screen linear 8888 buffer through the DPU SysMMU,
+	  including padded pitch, with a limited CPU-copy fallback. No panel
+	  power cycling, scaling, blending, protected content or suspend support.
+
+config FB_A50_DIAGNOSTICS
+	bool "A50 display register snapshots for bring-up"
+	depends on FB_A50_HANDOVER && DEBUG_KERNEL
+	help
+	  Enable the read-only probe, early and late register dumps used by
+	  the recorded display tests. Disabled by default. Passive sysfs
+	  counters remain available independently of this option.
+
 config FB_HECUBA
 	tristate
 	depends on FB
