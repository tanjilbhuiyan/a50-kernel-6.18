 .../dts/exynos/exynos9610-a50-display.dts     |   50 +
 drivers/video/fbdev/Kconfig                   |   19 +
 drivers/video/fbdev/Makefile                  |    2 +
 drivers/video/fbdev/a50-decon.c               | 1142 +++++++++++++++++
 5 files changed, 1214 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos9610-a50-display.dts
 create mode 100644 drivers/video/fbdev/a50-decon.c

