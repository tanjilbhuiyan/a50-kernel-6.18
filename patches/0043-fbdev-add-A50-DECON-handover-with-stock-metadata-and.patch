+#ifdef CONFIG_FB_A50_DIAGNOSTICS
+static void a50_decon_log(struct a50_decon *d, const char *when)
+{
+	dev_info(d->dev, "G2b fence owner: context=%llu driver=a50-decon timeline=decon_f seq=%llu pending=%d stage=%s worker_seq=%llu worker_layers=%u completed=%u\n",
+		 (unsigned long long)READ_ONCE(d->fence_ctx), (unsigned long long)READ_ONCE(d->fence_seq),
+		 atomic_read(&d->remaining), READ_ONCE(d->g2b_stage),
+		 (unsigned long long)READ_ONCE(d->g2b_worker_seq), READ_ONCE(d->g2b_worker_layers),
+		 READ_ONCE(d->g2b_completed));
+	dev_info(d->dev, "%s: frames req=%u done=%u start=%u timeouts=%u extra=%u te=%u FRAME_COUNT=%u GLOBAL=0x%08x TRIG=0x%08x vsync_on=%d win_configs=%u copied=%u skipped=%u acq_timeouts=%u frame_wait_timeouts=%u scanned=%u dma_fallbacks=%u shadow_wait_timeouts=%u IDMA0=0x%08x blanks=%u unblanks=%u dcs=%u dcs_timeouts=%u\n",
+		 when, d->frames_req, d->frames_done, d->frame_start, d->timeouts, d->extra_irq,
+		 d->te_count, readl(d->regs + FRAME_COUNT), readl(d->regs + GLOBAL_CONTROL),
+		 readl(d->regs + TRIG_CTRL), d->vsync_on, d->win_configs, d->copied, d->skipped,
+		 d->acq_timeouts, d->frame_waits_timed_out, d->scanned, d->dma_fallbacks,
+		 d->shadow_waits_timed_out, readl(d->idma + IDMA_IN_BASE_ADDR_Y), d->blanks, d->unblanks,
+		 d->dcs_sent, d->dcs_timeouts);
+	dev_info(d->dev, "G2g IDMA geometry: src_size=0x%08x src_offset=0x%08x img_size=0x%08x padded_scanned=%u\n",
+		 readl(d->idma + IDMA_SRC_SIZE), readl(d->idma + IDMA_SRC_OFFSET),
+		 readl(d->idma + IDMA_IMG_SIZE), d->padded_scanned);
+}
+
+static void a50_decon_report(struct work_struct *w)
+{
+	a50_decon_log(container_of(w, struct a50_decon, report_work.work), "2 s after probe");
+}
+
+static void a50_decon_late(struct work_struct *w)
+{
+	a50_decon_log(container_of(w, struct a50_decon, late_work.work), "late");
+}
