--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -23,3 +23,4 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynosautov920-sadk.dtb
 
 dtb-$(CONFIG_ARCH_EXYNOS) += exynos9610-a50-sysmmu.dtb
+dtb-$(CONFIG_ARCH_EXYNOS) += exynos9610-a50-display.dtb
diff --git a/arch/arm64/boot/dts/exynos/exynos9610-a50-display.dts b/arch/arm64/boot/dts/exynos/exynos9610-a50-display.dts
new file mode 100644
index 000000000..ccad7e3dd
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9610-a50-display.dts
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A50 DPU SysMMU profile plus the display
+ * handover driver node. simplefb is disabled so that the a50-decon fbdev
+ * device owns the boot framebuffer. Values from the stock DT decon_f node
+ * (reference/stock-dt/dt.dtb.0.dts): DECON registers, frame start/done/extra
+ * interrupts SPI 199/200/203, TE on gpc2-3 (hw_te_on pin function 0xf).
+ * The node sits at the root, as in the stock DT, so the platform device is
+ * /sys/devices/platform/148b0000.decon_f, whose "vsync" attribute the stock
+ * composer reads.
+ */
+#include "exynos9610-a50-sysmmu.dts"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	chosen {
+		framebuffer@ca000000 {
+			status = "disabled";
+		};
+	};
+
+	/* At the root like the stock DT, so the device is /sys/devices/platform/148b0000.decon_f. */
+	decon_f: decon_f@148b0000 {
+		compatible = "samsung,a50-decon-handover";
+		reg = <0x0 0x148b0000 0x10000>;
+		memory-region = <&{/reserved-memory/fb_reserved@ca000000}>;
+		interrupts = <GIC_SPI 199 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
+		te-gpios = <&gpc2 3 GPIO_ACTIVE_HIGH>;
+		clocks = <&cmu_top CLK_GOUT_CMU_DISPAUD_DISP>,
+			 <&cmu_dispaud CLK_GOUT_DISPAUD_SMMU_DPU_CLK>,
+			 <&cmu_dispaud CLK_GOUT_DISPAUD_DPU_ACLK_DECON>,
+			 <&cmu_dispaud CLK_GOUT_DISPAUD_DPU_ACLK_DMA>,
+			 <&cmu_dispaud CLK_GOUT_DISPAUD_DPU_ACLK_DPP>;
+		/* M7.2 D3a: DMA through the DPU SysMMU (default DMA domain). */
+		iommus = <&sysmmu_dpu>;
+	};
+};
+
+/*
+ * M7.2 D3a: identity-map the boot framebuffer in the display's IOMMU domain,
+ * so IDMA0's base 0xca000000 (programmed by S-Boot) stays valid once
+ * translation starts. Same range as reg, so the core makes it a direct mapping
+ * (of_iommu_get_resv_regions: IOMMU_RESV_DIRECT). Samsung's driver does the same
+ * with iovmm_map_oto() (4.14 dsim_drv.c:1134).
+ */
+&{/reserved-memory/fb_reserved@ca000000} {
+	iommu-addresses = <&decon_f 0x0 0xca000000 0xa00000>;
+};
diff --git a/drivers/video/fbdev/Kconfig b/drivers/video/fbdev/Kconfig
