From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Sun, 8 Nov 2026 15:05:52 +0600
Subject: [PATCH 22/35] arm64: dts: exynos9610: add PMU syscon, FSYS sysreg,
 UFS host and UFS PHY

Hardware facts from the stock DT. No ref_clk or ref-clk-freq on the host
and no regulators, so the UFS core cannot write bRefClkFreq and the
bootloader's supply state is left alone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ib3c90517c958ef11ef218c4e40159b3aed97561e
---
 .../bindings/soc/samsung/exynos-pmu.yaml      |  2 +
 arch/arm64/boot/dts/exynos/exynos9610.dtsi    | 51 +++++++++++++++++++
 2 files changed, 53 insertions(+)

diff --git a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
index f0fb24156..602606b5e 100644
--- a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
+++ b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
@@ -27,6 +27,7 @@ select:
           - samsung,exynos5433-pmu
           - samsung,exynos7-pmu
           - samsung,exynos850-pmu
+          - samsung,exynos9610-pmu
           - samsung-s5pv210-pmu
   required:
     - compatible
@@ -48,6 +49,7 @@ properties:
               - samsung,exynos5433-pmu
               - samsung,exynos7-pmu
               - samsung,exynos850-pmu
+              - samsung,exynos9610-pmu
               - samsung-s5pv210-pmu
           - const: syscon
       - items:
diff --git a/arch/arm64/boot/dts/exynos/exynos9610.dtsi b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
index 866bd42bc..7aaef8675 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
@@ -158,6 +158,16 @@ wakeup-interrupt-controller {
 			};
 		};
 
+		/*
+		 * Register access only (UFS PHY isolation). Deliberately not an
+		 * exynos7-pmu fallback: that would bind the exynos-pmu driver with
+		 * another SoC's register table.
+		 */
+		pmu_system_controller: system-controller@11860000 {
+			compatible = "samsung,exynos9610-pmu", "syscon";
+			reg = <0x11860000 0x10000>;
+		};
+
 		pinctrl_cmgp: pinctrl@11c20000 {
 			compatible = "samsung,exynos9610-pinctrl";
 			reg = <0x11c20000 0x1000>;
@@ -231,12 +241,53 @@ cmu_fsys: clock-controller@13400000 {
 				      "dout_cmu_fsys_ufs_embd";
 		};
 
+		sysreg_fsys: system-controller@13410000 {
+			compatible = "samsung,exynos9610-fsys-sysreg", "syscon";
+			reg = <0x13410000 0x1020>;
+			clocks = <&cmu_fsys CLK_GOUT_FSYS_SYSREG_PCLK>;
+		};
+
 		pinctrl_fsys: pinctrl@13490000 {
 			compatible = "samsung,exynos9610-pinctrl";
 			reg = <0x13490000 0x1000>;
 			interrupts = <GIC_SPI 150 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		/*
+		 * M3.5. Addresses, IRQ and coherency from the stock DT. Safety: no
+		 * clock named "ref_clk" and no "ref-clk-freq" on this node, so the
+		 * UFS core never writes the persistent bRefClkFreq attribute; no
+		 * regulators, so the bootloader's VCC state is left alone.
+		 * freq-table-hz 0 keeps the bootloader's clock rates.
+		 */
+		ufs: ufs@13520000 {
+			compatible = "samsung,exynos9610-ufs";
+			reg = <0x13520000 0x200>,
+			      <0x13521100 0x200>,
+			      <0x13510000 0x8000>,
+			      <0x13530000 0x100>;
+			reg-names = "hci", "vs_hci", "unipro", "ufsp";
+			interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_fsys CLK_GOUT_FSYS_UFS_EMBD_ACLK>,
+				 <&cmu_fsys CLK_GOUT_FSYS_UFS_EMBD_CLK_UNIPRO>;
+			clock-names = "core_clk", "sclk_unipro_main";
+			freq-table-hz = <0 0>, <0 0>;
+			phys = <&ufs_phy>;
+			phy-names = "ufs-phy";
+			samsung,sysreg = <&sysreg_fsys 0x1010>;
+			dma-coherent;
+		};
+
+		ufs_phy: phy@13524000 {
+			compatible = "samsung,exynos9610-ufs-phy";
+			reg = <0x13524000 0x800>;
+			reg-names = "phy-pma";
+			clocks = <&oscclk>;
+			clock-names = "ref_clk";
+			samsung,pmu-syscon = <&pmu_system_controller>;
+			#phy-cells = <0>;
+		};
+
 		pinctrl_top: pinctrl@139b0000 {
 			compatible = "samsung,exynos9610-pinctrl";
 			reg = <0x139b0000 0x1000>;
