diff --git a/arch/arm64/boot/dts/exynos/exynos9610.dtsi b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
index 70efb4ebc..866bd42bc 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
@@ -24,6 +24,15 @@ / {
 	/* S:178-281 - 4x Cortex-A53 (MPIDR 0x0-0x3), 4x Cortex-A73 (MPIDR 0x100-0x103),
 	 * enable-method psci. The 4.14 DT labels the A73s cpu4..cpu7.
 	 */
+	aliases {
+		pinctrl0 = &pinctrl_alive;
+		pinctrl1 = &pinctrl_cmgp;
+		pinctrl2 = &pinctrl_dispaud;
+		pinctrl3 = &pinctrl_fsys;
+		pinctrl4 = &pinctrl_top;
+		pinctrl5 = &pinctrl_shub;
+	};
+
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
@@ -132,9 +141,34 @@ soc: soc@0 {
 		#size-cells = <1>;
 		ranges = <0x0 0x0 0x0 0x20000000>;
 
-		/* S:592-602 - GICv2: dist 0x12301000, cpu 0x12302000,
-		 * hyp 0x12304000, vcpu 0x12306000; maintenance PPI 9.
-		 */
+		pinctrl_shub: pinctrl@11080000 {
+			compatible = "samsung,exynos9610-pinctrl";
+			reg = <0x11080000 0x1000>;
+			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		pinctrl_alive: pinctrl@11850000 {
+			compatible = "samsung,exynos9610-pinctrl";
+			reg = <0x11850000 0x1000>;
+
+			wakeup-interrupt-controller {
+				compatible = "samsung,exynos9610-wakeup-eint",
+					     "samsung,exynos850-wakeup-eint",
+					     "samsung,exynos7-wakeup-eint";
+			};
+		};
+
+		pinctrl_cmgp: pinctrl@11c20000 {
+			compatible = "samsung,exynos9610-pinctrl";
+			reg = <0x11c20000 0x1000>;
+
+			wakeup-interrupt-controller {
+				compatible = "samsung,exynos9610-wakeup-eint",
+					     "samsung,exynos850-wakeup-eint",
+					     "samsung,exynos7-wakeup-eint";
+			};
+		};
+
 		/*
 		 * M3.3: only the CMUs that UFS (FSYS) and USB need, plus their parent
 		 * TOP. Addresses: Samsung 4.14 cal-if/exynos9610/cmucal-sfr.c:11,16,25
@@ -152,6 +186,9 @@ cmu_top: clock-controller@12100000 {
 			clock-names = "oscclk";
 		};
 
+		/* S:592-602 - GICv2: dist 0x12301000, cpu 0x12302000,
+		 * hyp 0x12304000, vcpu 0x12306000; maintenance PPI 9.
+		 */
 		gic: interrupt-controller@12301000 {
 			compatible = "arm,cortex-a15-gic";
 			#interrupt-cells = <3>;
@@ -193,5 +230,24 @@ cmu_fsys: clock-controller@13400000 {
 				      "dout_cmu_fsys_mmc_embd",
 				      "dout_cmu_fsys_ufs_embd";
 		};
+
+		pinctrl_fsys: pinctrl@13490000 {
+			compatible = "samsung,exynos9610-pinctrl";
+			reg = <0x13490000 0x1000>;
+			interrupts = <GIC_SPI 150 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		pinctrl_top: pinctrl@139b0000 {
+			compatible = "samsung,exynos9610-pinctrl";
+			reg = <0x139b0000 0x1000>;
+			interrupts = <GIC_SPI 266 IRQ_TYPE_LEVEL_HIGH>;
+		};
