From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tanjilbhuiyan <tanjilbhuiyan@gmail.com>
Date: Wed, 18 Nov 2026 12:32:29 +0600
Subject: [PATCH 47/56] arm64: dts: exynos9610-a50: enable I2C on the
 bootloader PERI clock

Enable I2C buses 0, 1, 3, 4 and 6 with the stock bus speeds and SDA delay.
CMU_PERI is not registered: the bootloader leaves every PERI gate enabled and
every I2C Q-channel requesting its clock, while registering the CMU_PERI
driver hard-locked a CPU during boot on this phone. The controllers use a
fixed clock describing the measured PERI bus rate (66.625 MHz), which is also
the parent of the stock I2C Q-channel clocks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I300e2bc090c7df3058eb105ac7477a7cda978655
---
 arch/arm64/boot/dts/exynos/exynos9610-a50.dts | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
index 64c413d08..7576e5487 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
@@ -23,6 +23,19 @@ / {
 	dtb-hw_rev = <0x00>;
 	dtb-hw_rev_end = <0xff>;
 
+	/*
+	 * CMU_PERI is left as the bootloader configures it (ADR-0007): every PERI
+	 * gate on and every I2C Q-channel requesting its clock. Registering the 6.18
+	 * CMU_PERI driver hard-locked a CPU during boot (M8.1 T3), so PERI consumers
+	 * use this fixed clock at the measured PERI bus rate (dout_cmu_peri_bus,
+	 * 66625000 Hz), which is also the stock parent of GATE_I2C_n_QCH.
+	 */
+	peri_bus_bootclk: clock-peri-bus-boot {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <66625000>;
+	};
+
 	chosen {
 		#address-cells = <2>;
 		#size-cells = <1>;
@@ -148,3 +161,38 @@ &usbdrd {
 	vdd10-supply = <&ldo12_reg>;
 	vdd33-supply = <&ldo14_reg>;
 };
+
+/* Bus speeds and SDA delay as in the stock DTBO (O); buses 3 and 6 use the default. */
+&i2c_0 {
+	clocks = <&peri_bus_bootclk>;
+	clock-names = "i2c";
+	samsung,i2c-max-bus-freq = <400000>;
+	status = "okay";
+};
+
+&i2c_1 {
+	clocks = <&peri_bus_bootclk>;
+	clock-names = "i2c";
+	samsung,i2c-max-bus-freq = <400000>;
+	status = "okay";
+};
+
+&i2c_3 {
+	clocks = <&peri_bus_bootclk>;
+	clock-names = "i2c";
+	status = "okay";
+};
+
+&i2c_4 {
+	clocks = <&peri_bus_bootclk>;
+	clock-names = "i2c";
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+	status = "okay";
+};
+
+&i2c_6 {
+	clocks = <&peri_bus_bootclk>;
+	clock-names = "i2c";
+	status = "okay";
+};
