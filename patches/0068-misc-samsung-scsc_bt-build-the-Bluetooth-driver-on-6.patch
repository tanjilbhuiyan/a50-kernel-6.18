+
+/* /dev/scsc_h4_0 (char device, fallback path of ADR-0008): bounce userspace buffers through the kernel core. */
+#define SCSC_BT_H4_BOUNCE_MAX	(64 * 1024)
+
+ssize_t scsc_bt_shm_h4_read(struct file *file, char __user *buf, size_t len, loff_t *offset)
+{
+	size_t n = min_t(size_t, len, SCSC_BT_H4_BOUNCE_MAX);
+	char *kbuf;
+	ssize_t ret;
+
+	kbuf = kmalloc(n, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+	ret = scsc_bt_shm_h4_read_kernel(file->f_flags & O_NONBLOCK, kbuf, n);
+	if (ret > 0 && copy_to_user(buf, kbuf, ret))
+		ret = -EFAULT;
+	kfree(kbuf);
+	return ret;
+}
+
+ssize_t scsc_bt_shm_h4_write(struct file *file, const char __user *buf, size_t count, loff_t *offset)
+{
+	char *kbuf;
+	ssize_t ret;
+
+	if (count > SCSC_BT_H4_BOUNCE_MAX)
+		count = SCSC_BT_H4_BOUNCE_MAX;
+	kbuf = memdup_user(buf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+	ret = scsc_bt_shm_h4_write_kernel(kbuf, count);
+	kfree(kbuf);
+	return ret;
+}
