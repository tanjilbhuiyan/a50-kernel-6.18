@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung SCSC Bluetooth, reduced for the 6.18 A50 port (ADR-0008): the SCSC Bluetooth service and its shared-memory
+# H4 transport, exposed to BlueZ as a native hci_dev (scsc_bluez.c). ANT and the EFS address file are not ported.
+
+config SCSC_BT
+	tristate "Samsung SCSC Bluetooth"
+	depends on SCSC_CORE && BT && BT_HCIUART_H4
+	help
+	  Bluetooth for the Samsung SCSC (Maxwell) chip of Exynos 9610,
+	  registered with BlueZ as a native HCI device. Uses the stock
+	  firmware through the SCSC core.
