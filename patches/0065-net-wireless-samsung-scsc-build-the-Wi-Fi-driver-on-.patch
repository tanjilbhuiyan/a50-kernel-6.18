+			    bool pairwise, const u8 *mac_addr, struct key_params *params)
+{
+	return slsi_add_key(wiphy, wdev->netdev, key_index, pairwise, mac_addr, params);
+}
+
+static int slsi_618_del_key(struct wiphy *wiphy, struct wireless_dev *wdev, int link_id, u8 key_index,
+			    bool pairwise, const u8 *mac_addr)
