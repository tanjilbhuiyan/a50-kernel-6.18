--- /dev/null
+++ b/drivers/net/wireless/samsung/scsc/Kconfig
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung SCSC Wi-Fi, reduced for the 6.18 A50 port: station mode on cfg80211/nl80211.
+# Android vendor commands (GSCAN, NAN, RTT, WES/NCHO), the wifilogger and debug/test
+# options of the 4.14 driver are not ported.
+
+config SCSC_WLAN
+	tristate "Samsung SCSC Wi-Fi"
+	depends on SCSC_CORE && CFG80211
+	help
+	  Wi-Fi driver for the Samsung SCSC (Maxwell) chip of Exynos 9610,
+	  using the stock firmware through the SCSC core.
+
+if SCSC_WLAN
+
+config SCSC_WLAN_MAX_INTERFACES
+	int "Number of network interfaces"
+	range 1 3
+	default 3
+	help
+	  wlan0, p2p0 and the AP interface, as on the stock kernel.
+
+config SCSC_WLAN_WES_NCHO
+	def_bool y
+	help
+	  Samsung's private-command code (ioctl.c) only builds with WES/NCHO.
+	  On 6.18 those commands are unreachable (SIOCDEVPRIVATE goes to
+	  ndo_siocdevprivate, which this driver does not implement), so all
+	  NCHO modes stay at their default 0 and behave like a non-NCHO build.
+
+config SCSC_AP_INTERFACE_NAME
+	string "AP interface name"
+	default "swlan0"
+
+endif
