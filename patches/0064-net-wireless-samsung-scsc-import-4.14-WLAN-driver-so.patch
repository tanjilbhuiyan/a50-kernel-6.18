+/* Collect client registration for HCF file*/
+static struct scsc_log_collector_client slsi_hcf_client = {
+	.name = "wlan_hcf",
+	.type = SCSC_LOG_CHUNK_WLAN_HCF,
+	.collect_init = NULL,
+	.collect = slsi_hcf_collect,
+	.collect_end = NULL,
+	.prv = NULL,
+};
+#endif
