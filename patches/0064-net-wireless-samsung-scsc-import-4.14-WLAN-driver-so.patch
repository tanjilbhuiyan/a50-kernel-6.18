+	}
+
+	if (!mib || !mib->data) {
+		SLSI_ERR(sdev, "Invalid MIB country table\n");
+		return -EINVAL;
+	}
+
+	memcpy(sdev->device_config.domain_info.countrylist, mib->data, len);
+	sdev->device_config.domain_info.country_len = len;
+
+	return 0;
+}
