+bool slsi_if_valid_wifi_sharing_channel(struct slsi_dev *sdev, int freq)
+{
+	int i;
+
+	for (i = 0; i <= (SLSI_MAX_CHAN_5G_BAND - 1) ; i++) {
+		if (sdev->valid_5g_chan[i] == ieee80211_get_channel(sdev->wiphy, freq)->hw_value)
+			return 1;
+	}
+	return 0;
+}
