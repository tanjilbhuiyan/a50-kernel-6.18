+int slsi_mlme_set_traffic_parameters(struct slsi_dev *sdev, struct net_device *dev, u16 user_priority, u16 medium_time, u16 minimun_data_rate, u8 *mac)
+{
+	struct netdev_vif *ndev_vif = netdev_priv(dev);
