+	u8 config_2dot4g_sdf;
+	u8 sdf_2dot4g_val;
+	u8 config_5g_beacons;
+	u8 beacon_5g_val;
+	u8 config_5g_sdf;
+	u8 sdf_5g_val;
+	u8 config_5g_rssi_close;
