+#define UNIFI_CFG_STREAM_OPERATION_TYPE_STOP       ((unifiio_stream_cfg_operation_type)2)
+#define UNIFI_CFG_STREAM_OPERATION_TYPE_DELETE     ((unifiio_stream_cfg_operation_type)3)
