+	if (strlen(ioctl_args->args[0]) != 17) {
+		SLSI_ERR(sdev, "Invalid MAC address length :%d\n", (int)strlen(ioctl_args->args[0]));
+		kfree(ioctl_args);
+		return -EINVAL;
+	}
+
+	slsi_machexstring_to_macarray(ioctl_args->args[0], bssid);
