+		goto exit;
+	}
+
+	memcpy(&peer->qos_map, qos_map, sizeof(struct cfg80211_qos_map));
+	peer->qos_map_set = true;
+
+exit:
+	SLSI_MUTEX_UNLOCK(ndev_vif->vif_mutex);
+	return r;
+}
