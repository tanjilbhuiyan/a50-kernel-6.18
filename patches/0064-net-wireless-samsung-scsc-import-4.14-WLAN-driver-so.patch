+		kfree(ioctl_args);
+		return -EINVAL;
+	}
+	if (mode < 0 || mode > 3) {
+		SLSI_ERR(sdev, "Invalid mode: '%d'\n", mode);
+		kfree(ioctl_args);
+		return -EINVAL;
+	}
+	if (!slsi_str_to_int(ioctl_args->args[1], &uid)) {
+		SLSI_ERR(sdev, "Invalid string uid: '%s'\n", ioctl_args->args[1]);
+		kfree(ioctl_args);
+		return -EINVAL;
