+		SLSI_MUTEX_UNLOCK(ndev_vif->vif_mutex);
+		res = snprintf(command, buf_len, "-1\n");
+		return res;
+	}
+
+	res = slsi_get_beacon_cu(sdev, dev, &mib_value);
+	SLSI_MUTEX_UNLOCK(ndev_vif->vif_mutex);
+
+	if (res)
+		return res;
+
+	res = snprintf(command, buf_len, "%d\n", mib_value);
+	return res;
