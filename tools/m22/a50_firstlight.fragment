# Minimal first-light config (M2.2). Merged on top of arm64 allnoconfig.
CONFIG_ARCH_EXYNOS=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_CMDLINE="console=tty0 loglevel=7 ignore_loglevel"
CONFIG_CMDLINE_EXTEND=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_LOCALVERSION="-a50-firstlight"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# Core errata workarounds as in standard arm64 defconfigs (4x Cortex-A53, 4x Cortex-A73); applicability per core revision unverified
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_858921=y
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_S2MPU09_ACPM=y
