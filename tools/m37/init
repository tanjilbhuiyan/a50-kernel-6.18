#!/a50/busybox sh
# M3.7 ramdisk test init (rdinit=/a50/init). Does not run any Halium code: it checks that the bootloader's ramdisk arrived
# intact (against a sha256 manifest built on the laptop) and reports to /dev/kmsg. No storage drivers in this kernel.
export PATH=/a50/bin
/a50/busybox mkdir -p /a50/bin /proc /sys /dev /tmp
/a50/busybox --install -s /a50/bin
mount -t proc proc /proc; mount -t sysfs sysfs /sys; mount -t devtmpfs devtmpfs /dev
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t configfs configfs /sys/kernel/config
say() { echo "<6>a50-m37: $*" > /dev/kmsg; }
say "init started, Linux $(uname -r), uptime $(cut -d' ' -f1 /proc/uptime) s"
say "kmsg: $(dmesg | grep -E 'Initramfs unpacking|Unpacking initramfs|Freeing initrd' | sed 's/^\[[^]]*\] //' | tr '\n' ';')"
C=/proc/device-tree/chosen
hx() { od -An -tx1 "$1" 2>/dev/null | tr -d ' \n'; }
s=$(hx $C/linux,initrd-start); e=$(hx $C/linux,initrd-end)
if [ -n "$s" ] && [ -n "$e" ]; then say "chosen initrd start=0x$s end=0x$e size=$(( 0x$e - 0x$s )) (boot.img ramdisk is 10792361)"; else say "chosen has NO initrd properties"; fi
say "rootfs top: $(ls / | tr '\n' ' ')"
ok=0; bad=0; missing=0; total=0; names=""
while read -r sum name; do
  total=$((total+1))
  if [ ! -f "/$name" ]; then missing=$((missing+1)); [ $missing -le 5 ] && names="$names missing:$name"; continue; fi
  if [ "$(sha256sum "/$name" | cut -d' ' -f1)" = "$sum" ]; then ok=$((ok+1)); else bad=$((bad+1)); [ $bad -le 5 ] && names="$names bad:$name"; fi
done < /a50/manifest
say "MANIFEST total=$total ok=$ok bad=$bad missing=$missing$names"
if [ "$ok" = "$total" ]; then say "RESULT: ramdisk INTACT"; elif [ "$ok" = 0 ]; then say "RESULT: ramdisk NOT UNPACKED"; else say "RESULT: ramdisk PARTIAL/CORRUPT"; fi
i=0; while [ $i -lt 20 ] && [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; do sleep 1; i=$((i+1)); done
udc=$(ls /sys/class/udc 2>/dev/null | head -1); say "udc after ${i}s: ${udc:-NONE}"
if [ -n "$udc" ]; then
  g=/sys/kernel/config/usb_gadget/g1; mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 $g/functions/acm.GS0
  echo 0x1d6b > $g/idVendor; echo 0x0104 > $g/idProduct; echo 0x0200 > $g/bcdUSB
  echo "a50-test" > $g/strings/0x409/serialnumber; echo "A50 6.18" > $g/strings/0x409/manufacturer; echo "A50 ACM test" > $g/strings/0x409/product
  echo "acm" > $g/configs/c.1/strings/0x409/configuration; ln -s $g/functions/acm.GS0 $g/configs/c.1/
  echo "$udc" > $g/UDC; say "gadget bound rc=$?"
  ( while :; do [ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
fi
say "report done; waiting for the delayed dump"; while :; do sleep 60; done
