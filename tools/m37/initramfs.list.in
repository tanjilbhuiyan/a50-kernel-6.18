# M3.7: everything of ours lives under /a50, so the bootloader's Halium ramdisk can overlay / without touching it. @REPO@ is replaced by the build script.
dir /dev 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 0755 0 0
dir /a50 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
file /a50/busybox @REPO@/src/m22/busybox 0755 0 0
file /a50/init @REPO@/tools/m22/init 0755 0 0
file /a50/manifest @REPO@/src/m36/halium-manifest.txt 0644 0 0
