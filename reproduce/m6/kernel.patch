diff --git a/arch/arm64/Kconfig.debug b/arch/arm64/Kconfig.debug
index 265c44610..36ee00405 100644
--- a/arch/arm64/Kconfig.debug
+++ b/arch/arm64/Kconfig.debug
@@ -20,4 +20,47 @@ config ARM64_RELOC_TEST
 	depends on m
 	tristate "Relocation testing module"
 
+config A50_DIAG
+	bool "Galaxy A50 first-light diagnostics (paints framebuffer bands, writes DRAM markers)"
+	help
+	  Debug aid for bringing up the Samsung Galaxy A50 without a serial
+	  console: paints coloured bands into the bootloader framebuffer and
+	  writes stage markers into DRAM at several points of the boot, then
+	  tries a PSCI SYSTEM_RESET. Never enable on anything else.
+
+config A50_DIAG_RESET_STAGE
+	int "A50 diag: reset the SoC on reaching stage N (0 = never)"
+	depends on A50_DIAG
+	range 0 16
+	default 0
+	help
+	  Writes 1 to the Exynos9610 PMU SWRESET register at the start of
+	  diagnostic stage N (1 setup_arch, 2 arch_initcall, 3 late_initcall).
+	  The resulting boot loop is the only observable signal on the phone.
+	  10..16: bisection points in start_kernel()/kernel_init_freeable(),
+	  see A50_POINT() in init/main.c.
+
+config A50_DIAG_SKIP_MCT
+	bool "A50 diag: skip the Exynos MCT timer init"
+	depends on A50_DIAG && CLKSRC_EXYNOS_MCT
+	help
+	  The stock A50 DT has an exynos4210-mct node whose clocks come from
+	  samsung,exynos9610-clock, which has no 6.18 driver; mct_init_dt()
+	  then panics. Diagnostic switch only.
+
+config A50_DIAG_DUMP_DSS
+	bool "A50 diag: at late_initcall, dump the printk log to the DSS buffer and reboot to Download mode"
+	depends on A50_DIAG
+	help
+	  Appends the printk log to the debug-snapshot log_kernel buffer at
+	  the bootloader's end pointer, then reboots to Download mode by
+	  software. The baseline kernel's /proc/last_kmsg then shows it.
+
+config A50_DIAG_DUMP_AFTER
+	int "A50 diag: when to dump (0 = late_initcall, N = after N s, -1 = only on panic)"
+	depends on A50_DIAG_DUMP_DSS
+	default 0
+	help
+	  Default for the a50_diag.dump_after= parameter. A panic always dumps.
+
