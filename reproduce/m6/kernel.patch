+#ifdef CONFIG_ION_EXYNOS_COMPAT
+#define ION_DMA_BUF_TRACK _IO('b', 8)
+#define ION_DMA_BUF_UNTRACK _IO('b', 9)
+
+static int dma_buf_ion_track(struct dma_buf *dmabuf, bool track)
+{
+	struct task_dma_buf_info *info = current->dmabuf_info;
+	struct task_dma_buf_record *record;
+	int result = 0;
+
+	if (!is_dmabuf_accounting_enabled())
+		return -EOPNOTSUPP;
+	if (!info)
+		return -ESRCH;
+	spin_lock(&info->lock);
+	record = find_task_dmabuf_record(info, dmabuf);
+	if (!record) {
+		result = -ENOENT;
+	} else if (track) {
+		if (record->ion_legacy_refs == UINT_MAX)
+			result = -EOVERFLOW;
+		else
+			record->ion_legacy_refs++;
+	} else if (record->ion_legacy_refs) {
+		record->ion_legacy_refs--;
+	} else {
+		result = -ENOENT;
+	}
+	spin_unlock(&info->lock);
+	return result;
+}
+#endif
