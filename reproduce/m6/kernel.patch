+/*
+ * Exynos9610 USB 2.0 PHY (Samsung phy_version 0x300). Same register layout as
+ * Exynos850; the sequence follows Samsung's phy_exynos_usb_v3p1_enable() for this
+ * version (Galaxy A50 kernel), including its Q-channel workaround and link reset,
+ * and always forces VBUS valid (the board has no VBUS pad: is_not_vbus_pad).
+ */
+#define EXYNOS9610_LINKCTRL_DIS_QACT_LINKGATE	BIT(12)
+#define EXYNOS9610_LINKCTRL_DIS_QACT_ID0	BIT(11)
+#define EXYNOS9610_LINKCTRL_DIS_QACT_VBUS_VALID	BIT(10)
+#define EXYNOS9610_LINKCTRL_DIS_QACT_BVALID	BIT(9)
+#define EXYNOS9610_LINKPORT_SEL_OCD_U3		BIT(3)
+#define EXYNOS9610_LINKPORT_SEL_OCD_U2		BIT(2)
+
+/* usb_hs_tune of the Galaxy A50 stock DTBO, device-mode column */
+#define EXYNOS9610_HSP_TUNE_MASK \
+	(HSPPARACON_TXVREF | HSPPARACON_TXRISE | HSPPARACON_TXRES | \
+	 HSPPARACON_TXPREEMPPULSE | HSPPARACON_TXPREEMPAMP | HSPPARACON_TXHSXV | \
+	 HSPPARACON_TXFSLS | HSPPARACON_SQRX | HSPPARACON_OTG | HSPPARACON_COMPDIS)
+#define EXYNOS9610_HSP_TUNE_VAL \
+	(FIELD_PREP(HSPPARACON_TXVREF, 0xf) | FIELD_PREP(HSPPARACON_TXRISE, 3) | \
+	 FIELD_PREP(HSPPARACON_TXRES, 3) | FIELD_PREP(HSPPARACON_TXPREEMPAMP, 3) | \
+	 FIELD_PREP(HSPPARACON_TXHSXV, 3) | FIELD_PREP(HSPPARACON_TXFSLS, 3) | \
+	 FIELD_PREP(HSPPARACON_SQRX, 7) | FIELD_PREP(HSPPARACON_OTG, 2) | \
+	 FIELD_PREP(HSPPARACON_COMPDIS, 7))
+
+static void exynos9610_usbdrd_utmi_init(struct exynos5_usbdrd_phy *phy_drd)
+{
+	void __iomem *regs_base = phy_drd->reg_phy;
+	u32 reg;
+
+	/* Force the Q-channel active (vendor workaround) */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= EXYNOS9610_LINKCTRL_DIS_QACT_ID0 |
+	       EXYNOS9610_LINKCTRL_DIS_QACT_VBUS_VALID |
+	       EXYNOS9610_LINKCTRL_DIS_QACT_BVALID |
+	       EXYNOS9610_LINKCTRL_DIS_QACT_LINKGATE;
+	reg &= ~LINKCTRL_FORCE_QACT;
+	udelay(500);
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+	udelay(500);
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= LINKCTRL_FORCE_QACT;
+	udelay(500);
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+
+	/* Link reset */
+	reg = readl(regs_base + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_LINK_SW_RST;
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+	udelay(10);
+	reg &= ~CLKRST_LINK_SW_RST;
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+
+	/* PHY POR high */
+	reg = readl(regs_base + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_PHY_SW_RST | CLKRST_PHY_RESET_SEL | CLKRST_PORT_RST;
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+
+	/* Enable UTMI+ */
+	reg = readl(regs_base + EXYNOS850_DRD_UTMI);
+	reg &= ~(UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP | UTMI_DP_PULLDOWN |
+		 UTMI_DM_PULLDOWN);
+	writel(reg, regs_base + EXYNOS850_DRD_UTMI);
+
+	/* PHY clock and HS PHY control (common_block_disable = 1) */
+	reg = readl(regs_base + EXYNOS850_DRD_HSP);
+	reg |= HSP_EN_UTMISUSPEND | HSP_COMMONONN;
+	writel(reg, regs_base + EXYNOS850_DRD_HSP);
+	udelay(100);
+
+	/* No VBUS pad: bypass the filter and force the session valid */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= FIELD_PREP(LINKCTRL_BUS_FILTER_BYPASS, 0xf);
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+
+	reg = readl(regs_base + EXYNOS850_DRD_UTMI);
+	reg |= UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID;
+	writel(reg, regs_base + EXYNOS850_DRD_UTMI);
+
+	reg = readl(regs_base + EXYNOS850_DRD_HSP);
+	reg |= HSP_VBUSVLDEXT | HSP_VBUSVLDEXTSEL;
+	writel(reg, regs_base + EXYNOS850_DRD_HSP);
+
+	/* Board PHY tuning */
+	reg = readl(regs_base + EXYNOS850_DRD_HSPPARACON);
+	reg &= ~EXYNOS9610_HSP_TUNE_MASK;
+	reg |= EXYNOS9610_HSP_TUNE_VAL;
+	writel(reg, regs_base + EXYNOS850_DRD_HSPPARACON);
+
+	/* Power up the PHY analog blocks */
+	reg = readl(regs_base + EXYNOS850_DRD_HSP_TEST);
+	reg &= ~HSP_TEST_SIDDQ;
+	writel(reg, regs_base + EXYNOS850_DRD_HSP_TEST);
+	udelay(10);	/* required before POR low */
+
+	/* PHY POR low */
+	reg = readl(regs_base + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_PHY_RESET_SEL;
+	reg &= ~(CLKRST_PHY_SW_RST | CLKRST_PORT_RST);
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+	udelay(75);	/* PHYCLOCK guaranteed after this */
+
+	/* use_io_for_ovc = 0 */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKPORT);
+	reg |= EXYNOS9610_LINKPORT_SEL_OCD_U3 | EXYNOS9610_LINKPORT_SEL_OCD_U2;
+	writel(reg, regs_base + EXYNOS850_DRD_LINKPORT);
+
+	/*
+	 * This port is USB 2 only, so the SuperSpeed PHY is not running: force
+	 * the link's PIPE3 inputs. Without this the controller never connects
+	 * (Samsung's phy_exynos_usb_v3p1_pipe_ovrd).
+	 */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= LINKCTRL_FORCE_PIPE_EN | LINKCTRL_FORCE_RXELECIDLE;
+	reg &= ~LINKCTRL_FORCE_PHYSTATUS;
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+}
+
 static int exynos850_usbdrd_phy_init(struct phy *phy)
 {
 	struct phy_usb_instance *inst = phy_get_drvdata(phy);
@@ -1889,6 +2007,23 @@ static const struct exynos5_usbdrd_phy_config phy_cfg_exynos7870[] = {
 	},
 };
 
+/* stock DT: pmu_mask = <0x03> */
+static void exynos9610_usbdrd_phy_isol(struct phy_usb_instance *inst, bool isolate)
+{
+	if (!inst->reg_pmu)
+		return;
+
+	regmap_update_bits(inst->reg_pmu, inst->pmu_offset, 0x3, isolate ? 0 : 0x3);
+}
+
