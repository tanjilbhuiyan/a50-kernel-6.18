@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0
+/* M6.3 provider probe. No DMA master is attached to this controller. */
+#include "exynos9610-a50.dts"
+
+&soc {
+	/* Samsung cmucal-sfr.c DISPAUD block, manual CMU mode as in M3.3. */
+	cmu_dispaud: clock-controller@14980000 {
+		compatible = "samsung,exynos9610-cmu-dispaud";
+		reg = <0x14980000 0x8000>;
+		#clock-cells = <1>;
+		clocks = <&oscclk>,
+			 <&cmu_top CLK_DOUT_CMU_DISPAUD_AUD>,
+			 <&cmu_top CLK_DOUT_CMU_DISPAUD_CPU>,
+			 <&cmu_top CLK_DOUT_CMU_DISPAUD_DISP>;
+		clock-names = "oscclk", "dout_cmu_dispaud_aud",
+			      "dout_cmu_dispaud_cpu", "dout_cmu_dispaud_disp";
+	};
+
+	/* Stock DPU SysMMU, first/nonsecure interrupt. DISPAUD stays powered. */
+	sysmmu_dpu: iommu@14820000 {
+		compatible = "samsung,exynos-sysmmu";
+		reg = <0x14820000 0x9000>;
+		interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_SMMU_DPU_CLK>;
+		clock-names = "sysmmu";
+		#iommu-cells = <0>;
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos9610-a50.dts b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
new file mode 100644
index 000000000..64c413d08
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9610-a50.dts
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy A50 (SM-A505F) device tree - first-light subset
+ *
+ * Source key: S = 4.14 exynos9610.dts, D = reference/stock-dt/dt.dtb.0.dts
+ * (decompiled stock dt.img), O = reference/stock-dt/dtbo.5.dts (stock DTBO
+ * idx 5, which is what the phone boots with: androidboot.dtbo_idx=5).
+ */
+
+/dts-v1/;
+
+#include "exynos9610.dtsi"
+
+/ {
+	model = "Samsung Galaxy A50 (SM-A505F)";
+	compatible = "samsung,a50", "samsung,exynos9610";
+
+	/*
+	 * Board-revision window S-Boot uses to pick this DTB from the dt_table
+	 * (D root: dtb-hw_rev = <0x00>, dtb-hw_rev_end = <0xff>, i.e. all
+	 * revisions). Kept identical to stock so selection is unchanged.
+	 */
+	dtb-hw_rev = <0x00>;
+	dtb-hw_rev_end = <0xff>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Bootloader framebuffer, address from the kernel cmdline
+		 * s3cfb.bootloaderfb=0xca000000. Panel is 1080x2340 (O: ea8076
+		 * resolution = <0x438 0x924>). 4 bytes/pixel is ASSUMED:
+		 * neither the 4.14 source nor the stock DT records the
+		 * bootloader's pixel format (UNVERIFIED, resolve in M2.4; the
+		 * only open question is a8r8g8b8 vs a8b8g8r8).
+		 * size = 1080 * 4 * 2340 = 0x9a3f80.
+		 */
+		framebuffer@ca000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xca000000 0x9a3f80>;
+			width = <1080>;
+			height = <2340>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	/*
+	 * RAM: device is 4 GB (docs/01-device.md, MemTotal 3,690,784 kB).
+	 * D lists three 2 GB banks (0x80000000, 0x880000000, 0x900000000 = 6 GB);
+	 * the 4 GB cmdline (androidboot.dram_info=01,06,01,4G) suggests S-Boot
+	 * rewrites them - UNVERIFIED. Declaring only the first two banks is safe
+	 * on a 4 GB device either way.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x80000000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	/*
+	 * Fixed regions from D /reserved-memory (stock bootloader/firmware
+	 * carve-outs). Dynamic pools (ion_*, wifibt_if) are omitted.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		sec_debug_magic@80000000 {
+			reg = <0x0 0x80000000 0x1000>;
+			no-map;
+		};
+		vipx_fw@b8000000 {
+			reg = <0x0 0xb8000000 0x500000>;
+			no-map;
+		};
+		seclog@c0000000 {
+			reg = <0x0 0xc0000000 0x80000>;
+			no-map;
+		};
+		/* The bootloader framebuffer (see chosen) - not in D, added so
+		 * the kernel never allocates over the splash/console.
+		 */
+		fb_reserved@ca000000 {
+			reg = <0x0 0xca000000 0xa00000>;
+			no-map;
+		};
+		abox@e9400000 {
+			reg = <0x0 0xe9400000 0x2800000>;
+			no-map;
+		};
+		modem_if@ed000000 {
+			reg = <0x0 0xed000000 0x8a00000>;
+			no-map;
+		};
+		cp_ram_logging@f5a00000 {
+			reg = <0x0 0xf5a00000 0x1e00000>;
+			no-map;
+		};
+
+		/* debug_snapshot block, D: 0xf9000000..0xfa710000 (header, log_kernel,
+		 * log_platform, log_sfr, log_cachedump, log_bcm, log_pstore, log_kevents),
+		 * reserved whole. The log_pstore window (0xf9d10000) is NOT used for
+		 * ramoops: it stayed empty after a controlled panic on the baseline (M1.5).
+		 */
+		debug_snapshot@f9000000 {
+			reg = <0x0 0xf9000000 0x1710000>;
+			no-map;
+		};
+
+		/* S-Boot debug buffers passed on the command line (baseline /proc/cmdline):
+		 * sec_avc_log=0x40000@0x91202000, sec_tsp_log=0x40000@0x91244000,
+		 * sec_disp_log=0x100000@0x91286000. Reserved as one block together with
+		 * the 8 KiB gaps between them (0x91202000..0x91388000).
+		 */
+		sec_debug_bufs@91202000 {
+			reg = <0x0 0x91202000 0x186000>;
+			no-map;
+		};
+
+		/* S-Boot passes sec_debug_next=0x800000@0x91388000 on the command line;
+		 * kept reserved so 6.18 never hands it out. NOT used for ramoops: the
+		 * M1.5 claim that it survives a warm reset was wrong (/proc/last_kmsg
+		 * comes from the debug_snapshot log_kernel buffer, see the M1.5 log
+		 * CORRECTION). The crash-log readout is the debug_snapshot buffer
+		 * reserved above (M2.4 Test 19, M3.1).
+		 */
+		sec_debug_next@91388000 {
+			reg = <0x0 0x91388000 0x800000>;
+			no-map;
+		};
+
+		gnss_if@fb000000 {
+			reg = <0x0 0xfb000000 0x800000>;
+			no-map;
+		};
+		chub@fd000000 {
+			reg = <0x0 0xfd000000 0x80000>;
+			no-map;
+		};
+	};
+};
+
+&usbdrd {
+	vdd10-supply = <&ldo12_reg>;
+	vdd33-supply = <&ldo14_reg>;
+};
