+#ifdef CONFIG_A50_UFS_SAFE
+/*
+ * Galaxy A50 bring-up guard: the UFS device also holds EFS, PARAM and the
+ * bootloader, so nothing may change it until the port is proven. Default deny:
+ * only the SCSI opcodes and query operations listed here reach the device.
+ * set_disk_ro() is not enough, bio_check_ro() only warns.
+ */
+/* A50-GUARD-BEGIN: pure decisions, no device access (also unit-tested on the host) */
+static noinline bool a50_ufs_scsi_allowed(const u8 *cdb)
+{
+	switch (cdb[0]) {
+	case TEST_UNIT_READY:
+	case REQUEST_SENSE:
+	case READ_6:
+	case INQUIRY:
+	case MODE_SENSE:
+	case START_STOP:	/* power state only */
+	case READ_CAPACITY:
+	case READ_10:
+	case MODE_SENSE_10:
+	case READ_16:
+	case REPORT_LUNS:
+		return true;
+	case SERVICE_ACTION_IN_16:
+		return (cdb[1] & 0x1f) == SAI_READ_CAPACITY_16;
+	default:
+		return false;
+	}
+}
+
+static noinline bool a50_ufs_query_allowed(int opcode, u8 idn)
+{
+	switch (opcode) {
+	case UPIU_QUERY_OPCODE_READ_DESC:
+	case UPIU_QUERY_OPCODE_READ_ATTR:
+	case UPIU_QUERY_OPCODE_READ_FLAG:
+		return true;
+	case UPIU_QUERY_OPCODE_SET_FLAG:
+		return idn == QUERY_FLAG_IDN_FDEVICEINIT;
+	default:
+		return false;
+	}
+}
+
+/*
+ * A50_UFS_ALLOW_USERDATA: a write is allowed only on LUN 0, only as WRITE(10)
+ * or WRITE(16) with a non-zero length, and only when every block it touches
+ * lies in [first, last]. SYNCHRONIZE CACHE (10/16) is allowed on LUN 0. A range
+ * with first == 0 or last < first allows nothing.
+ */
+static noinline bool a50_ufs_write_allowed(u64 lun, const u8 *cdb, u64 first, u64 last)
+{
+	u64 lba;
+	u32 len;
+
+	if (lun != 0 || first == 0 || last < first)
+		return false;
+	switch (cdb[0]) {
+	case SYNCHRONIZE_CACHE:
+	case SYNCHRONIZE_CACHE_16:
+		return true;
+	case WRITE_10:
+		lba = ((u64)cdb[2] << 24) | ((u64)cdb[3] << 16) | ((u64)cdb[4] << 8) | cdb[5];
+		len = ((u32)cdb[7] << 8) | cdb[8];
+		break;
+	case WRITE_16:
+		lba = ((u64)cdb[2] << 56) | ((u64)cdb[3] << 48) | ((u64)cdb[4] << 40) |
+		      ((u64)cdb[5] << 32) | ((u64)cdb[6] << 24) | ((u64)cdb[7] << 16) |
+		      ((u64)cdb[8] << 8) | cdb[9];
+		len = ((u32)cdb[10] << 24) | ((u32)cdb[11] << 16) | ((u32)cdb[12] << 8) | cdb[13];
+		break;
+	default:
+		return false;
+	}
+	return len != 0 && lba >= first && lba <= last && len - 1 <= last - lba;
+}
+
+/* Builds a WRITE(10)/(16) CDB byte by byte, independently of the decoder above. */
+static void a50_ufs_mk_write(u8 *cdb, u8 op, u64 lba, u32 len)
+{
+	int i, n = op == 0x2a ? 4 : 8, m = op == 0x2a ? 2 : 4, at = op == 0x2a ? 7 : 2 + 8;
+
+	for (i = 0; i < 16; i++)
+		cdb[i] = 0;
+	cdb[0] = op;
+	for (i = 0; i < n; i++)
+		cdb[2 + i] = lba >> (8 * (n - 1 - i));
+	for (i = 0; i < m; i++)
+		cdb[at + i] = len >> (8 * (m - 1 - i));
+}
+
+/*
+ * Checks a50_ufs_write_allowed() for one range: boundaries, straddles, other
+ * LUNs and every other opcode. Returns the number of wrong decisions.
+ */
+static noinline int a50_ufs_write_selftest(u64 first, u64 last)
+{
+	static const u64 luns[] = { 0, 1, 2, 3, 0xc1b0, 0xc1c4, 0xc1d0 };
+	static const u8 ops[] = { 0x2a, 0x8a };
+	struct { u64 lba; u32 len; bool ok; } c[] = {
+		{ first, 1, true },
+		{ last, 1, true },
+		{ first, (u32)(last - first + 1 > 0xffff ? 0xffff : last - first + 1), true },
+		{ first - 1, 1, false },
+		{ first - 1, 2, false },
+		{ last, 2, false },
+		{ last + 1, 1, false },
+		{ 0, 1, false },
+		{ first, 0, false },
+		{ last - 1, 0xffff, false },
+		{ 0xffffffffULL, 0xffff, false },
+	};
+	u8 cdb[16];
+	int l, o, i, op, errors = 0;
+	bool valid = first != 0 && last >= first;
+
+	for (l = 0; l < ARRAY_SIZE(luns); l++) {
+		for (o = 0; o < ARRAY_SIZE(ops); o++) {
+			for (i = 0; i < ARRAY_SIZE(c); i++) {
+				bool expect = valid && luns[l] == 0 && c[i].ok;
+
+				/* WRITE(10) carries 32 bits of LBA only */
+				if (ops[o] == 0x2a && c[i].lba > 0xffffffffULL)
+					continue;
+				a50_ufs_mk_write(cdb, ops[o], c[i].lba, c[i].len);
+				if (a50_ufs_write_allowed(luns[l], cdb, first, last) != expect)
+					errors++;
+			}
+			/* WRITE(16): 64-bit wrap past the end */
+			a50_ufs_mk_write(cdb, 0x8a, ~0ULL, 2);
+			if (a50_ufs_write_allowed(luns[l], cdb, first, last))
+				errors++;
+		}
+		for (op = 0; op < 256; op++) {
+			bool expect = valid && luns[l] == 0 && (op == 0x35 || op == 0x91);
+
+			if (op == 0x2a || op == 0x8a)
+				continue;
+			a50_ufs_mk_write(cdb, 0x8a, first, 1);
+			cdb[0] = op;
+			if (a50_ufs_write_allowed(luns[l], cdb, first, last) != expect)
+				errors++;
+		}
+	}
+	return errors;
+}
+
+/*
+ * Exhaustive check of the two decisions above against an independent list of
+ * numeric values (deliberately not the symbolic names used above). Returns the
+ * number of wrong decisions.
+ */
+static noinline int a50_ufs_guard_selftest(void)
+{
+	static const u8 scsi_ok[] = {
+		0x00, 0x03, 0x08, 0x12, 0x1a, 0x1b, 0x25, 0x28, 0x5a, 0x88, 0xa0,
+	};
+	u8 cdb[2] = { 0, 0 };
+	int op, idn, sa, i, errors = 0;
+
+	for (op = 0; op < 256; op++) {
+		bool expect = false;
+
+		if (op == 0x9e)
+			continue;	/* depends on the service action, below */
+		for (i = 0; i < sizeof(scsi_ok); i++)
+			if (scsi_ok[i] == op)
+				expect = true;
+		cdb[0] = op;
+		if (a50_ufs_scsi_allowed(cdb) != expect)
+			errors++;
+	}
+
+	cdb[0] = 0x9e;
+	for (sa = 0; sa < 32; sa++) {
+		cdb[1] = sa;
+		if (a50_ufs_scsi_allowed(cdb) != (sa == 0x10))
+			errors++;
+	}
+
+	for (op = 0; op < 256; op++) {
+		for (idn = 0; idn < 256; idn++) {
+			bool expect = op == 0x01 || op == 0x03 || op == 0x05 ||
+				      (op == 0x06 && idn == 0x01);
+
+			if (a50_ufs_query_allowed(op, idn) != expect)
+				errors++;
+		}
+	}
+
+	return errors;
+}
+/* A50-GUARD-END */
