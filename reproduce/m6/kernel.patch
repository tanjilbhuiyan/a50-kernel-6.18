+#ifdef CONFIG_A50_UFS_ALLOW_USERDATA
+#define A50_UD_FIRST ((u64)CONFIG_A50_UFS_USERDATA_FIRST)
+#define A50_UD_LAST ((u64)CONFIG_A50_UFS_USERDATA_LAST)
+#else
+#define A50_UD_FIRST 0ULL	/* first == 0: nothing allowed */
+#define A50_UD_LAST 0ULL
+#endif
